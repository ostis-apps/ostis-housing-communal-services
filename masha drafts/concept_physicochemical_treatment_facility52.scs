concept_disinfection_facilities_52
=> nrel_main_idtf:
   [сооружения обеззараживания]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_treatment_facility;
-> rrel_example:
   chlorination_units;
   uv_disinfection_units;
   ozonation_units;
=> nrel_definition:
   [Сооружения обеззараживания — технические объекты, обеспечивающие снижение микробиологических загрязнений в очищенной сточной воде до установленных нормативов.]
   (*
       <- lang_ru;;
   *);;

concept_microbiological_pollutants_reduction
=> nrel_main_idtf:
   [снижение микробиологических загрязнений в очищенной сточной воде]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_wastewater_treatment_process;
-> rrel_example:
   reduction_of_total_coliform_bacteria;
   reduction_of_coliphages;
=> nrel_definition:
   [Снижение микробиологических загрязнений — уменьшение концентрации патогенных и индикаторных микроорганизмов (бактерий, вирусов, простейших) в очищенной сточной воде в результате обработки на сооружениях обеззараживания.]
   (*
       <- lang_ru;;
   *);;

concept_disinfection_efficiency
=> nrel_main_idtf:
   [эффективность работы сооружений обеззараживания]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
