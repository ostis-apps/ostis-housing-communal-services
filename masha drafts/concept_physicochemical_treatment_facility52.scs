-> rrel_example:
   log_reduction_value;
   percentage_removal_of_indicators;
=> nrel_definition:
   [Эффективность работы сооружений обеззараживания — количественная характеристика степени снижения микробиологических загрязнений, оцениваемая по индикаторным микробиологическим показателям (общие колиформные бактерии, колифаги).]
   (*
       <- lang_ru;;
   *);;

concept_indicator_microbiological_parameters
=> nrel_main_idtf:
   [индикаторные микробиологические показатели]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
-> rrel_example:
   total_coliform_bacteria;
   coliphages;
=> nrel_definition:
   [Индикаторные микробиологические показатели — группа микроорганизмов, присутствие которых в воде свидетельствует о возможном фекальном загрязнении и вероятности наличия патогенных бактерий и вирусов, используемых для оценки эффективности обеззараживания.]
   (*
       <- lang_ru;;
   *);;

concept_total_coliform_bacteria
=> nrel_main_idtf:
   [общие колиформные бактерии]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
-> rrel_example:
   thermotolerant_coliforms;
   fecal_coliforms;
   escherichia_coli;
=> nrel_definition:
   [Общие колиформные бактерии — группа грамотрицательных палочковидных бактерий (семейство Enterobacteriaceae), характеризующих уровень загрязнения сточных вод и вероятность присутствия возбудителей бактериальных кишечных инфекций.]
   (*
       <- lang_ru;;
   *);;

concept_coliphages
=> nrel_main_idtf:
   [колифаги]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
-> rrel_example:
   somatic_coliphages;
   f_specific_coliphages;
=> nrel_definition:
   [Колифаги — бактериальные вирусы, поражающие кишечную палочку (E. coli), используемые в качестве индикаторов вирусного загрязнения сточных вод для оценки эффективности обеззараживания в отношении энтеровирусов.]
   (*
       <- lang_ru;;
   *);;

concept_contamination_level_indicator
