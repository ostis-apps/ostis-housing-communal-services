concept_sorption_treatment_facilities
=> nrel_main_idtf:
   [сооружения сорбционной очистки]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_treatment_facility;
-> rrel_example:
   activated_carbon_filters;
   adsorption_columns;
   granular_sorption_filters;
=> nrel_definition:
   [Сооружения сорбционной очистки — технические объекты, предназначенные для глубокой очистки сточных вод с целью удаления из них растворенных органических веществ и тяжелых металлов методом сорбции.]
   (*
       <- lang_ru;;
   *);;

concept_deep_wastewater_treatment
=> nrel_main_idtf:
   [глубокая очистка сточных вод]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_wastewater_treatment_process; //нету такого, есть concept_technological_process
-> rrel_example:
   tertiary_treatment;
   polishing_treatment;
=> nrel_definition:
   [Глубокая очистка сточных вод — этап доочистки, обеспечивающий снижение концентрации загрязняющих веществ до значений, недостижимых при традиционной биологической или физико-химической очистке, в том числе удаление растворенных органических веществ и тяжелых металлов.]
   (*
       <- lang_ru;;
   *);;

