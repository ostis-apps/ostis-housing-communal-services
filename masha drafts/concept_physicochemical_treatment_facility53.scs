concept_ozonation_disinfection_facilities
=> nrel_main_idtf:
   [сооружения обеззараживания с применением метода озонирования]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_treatment_facility;
-> rrel_example:
   ozone_contact_tanks;
   ozone_generation_system;
   ozone_destruction_units;
=> nrel_definition:
   [Сооружения обеззараживания с применением метода озонирования — технические объекты, предназначенные для уничтожения патогенных микроорганизмов в сточной воде путём введения озона, получаемого на территории очистных сооружений.]
   (*
       <- lang_ru;;
   *);;

concept_ozonation_method
=> nrel_main_idtf:
   [метод озонирования]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_disinfection_method;
-> rrel_example:
   ozonation_of_wastewater;
   ozone_disinfection;
=> nrel_definition:
   [Метод озонирования — способ обеззараживания сточных вод путём введения озона (O₃) — сильного окислителя, обладающего бактерицидным и вирулицидным действием.]
   (*
       <- lang_ru;;
   *);;

concept_ozone
=> nrel_main_idtf:
   [озон]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
-> rrel_example:
   ozone_generated_from_air;
   ozone_generated_from_oxygen;
=> nrel_definition:
   [Озон — аллотропная модификация кислорода (O₃), сильный окислитель, получаемый на территории очистных сооружений из воздуха или технического кислорода в генераторах озона и применяемый для обеззараживания сточных вод.]
   (*
       <- lang_ru;;
   *);;

concept_ozone_production_on_site
=> nrel_main_idtf:
   [получение озона на территории очистных сооружений]
   (*
