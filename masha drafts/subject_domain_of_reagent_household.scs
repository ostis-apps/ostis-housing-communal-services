subject_domain_of_reagent_household

=> nrel_main_idtf:
    [Предметная область реагентного хозяйства](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_reagent_household
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[реагентное хозяйство] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_physicochemical_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Реагентное хозяйство предназначено для приготовления и дозирования в обрабатываемую сточную воду или осадок сточных вод реагентов, необходимых для проведения физико-химической очистки сточных вод.]
	                (*<-lang_ru;;*);;
                    ->[Своевременно готовить заданное количество растворов реагентов требуемой концентрации.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать дозирование растворов реагентов в обрабатываемую сточную воду или осадок в соответствии с технологическими требованиями.]
	                (*<-lang_ru;;*);;
                    ->[Поддерживать в исправном состоянии устройства для приготовления и дозирования реагентов, средств контроля и автоматизации, проводить их техническое обслуживание в соответствии с инструкциями изготовителей.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать требуемый запас реагентов и их своевременную поставку с учетом установленного порядка их расходования, возможностей их хранения, срока годности реагентов и технико-экономических показателей.]
	                (*<-lang_ru;;*);;
                    ->[Вести учет расхода и поступления реагентов.]
	                (*<-lang_ru;;*);;
                    ->[Выбор вида реагента и его дозы для обработки сточных вод и осадка устанавливаются с учетом проектной документации и уточняются при проведении пуско-наладочных работ на очистных сооружениях.]
	                (*<-lang_ru;;*);;
                    ->[В процессе эксплуатации очистных сооружений дозы реагентов, а также вид используемого реагента могут быть пересмотрены с учетом полученных данных по эффективности очистки сточных вод или обработки осадка.]
	                (*<-lang_ru;;*);;
                    ->[Точность дозирования реагентов обеспечивается в пределах, установленных изготовителями устройств для приготовления и дозирования реагентов.]
	                (*<-lang_ru;;*);;
                    ->[Резкое изменение установленных доз, а также перерывы в подаче реагентов не допускаются, за исключением случаев, предусмотренных технологией очистки сточных вод и обработки осадка.]
	                (*<-lang_ru;;*);;
                    ->[При длительных перерывах в подаче растворов реагентов, после каждого прекращения подачи раствора реагента, а также при замене одного вида реагента другим, трубопроводы реагентов, растворные и расходные баки и насосы-дозаторы промывают водой.]
	                (*<-lang_ru;;*);;
	        *);;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_reagent_solution
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[раствор реагента] (* <- lang_ru;; *);;
	*);
	concept_reagent_dosing_device
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[устройство для дозирования реагентов] (* <- lang_ru;; *);;
	*);
	concept_reagent_preparation_device
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[устройство для приготовления реагентов] (* <- lang_ru;; *);;
	*);
	concept_reagent_storage_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[растворный бак] (* <- lang_ru;; *);;
	*);
	concept_reagent_consumption_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[расходный бак] (* <- lang_ru;; *);;
	*);
	concept_dosing_pump
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[насос-дозатор] (* <- lang_ru;; *);;
	*);
	concept_reagent_pipeline
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[трубопровод реагента] (* <- lang_ru;; *);;
	*);
	concept_reagent_consumption
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[расход реагента] (* <- lang_ru;; *);;
	*);
	concept_reagent_dose
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[доза реагента] (* <- lang_ru;; *);;
	*);
	concept_reagent
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[реагент] (* <- lang_ru;; *);;
	*);;
