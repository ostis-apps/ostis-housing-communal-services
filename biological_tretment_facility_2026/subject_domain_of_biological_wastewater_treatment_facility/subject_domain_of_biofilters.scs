subject_domain_of_biofilters
=> nrel_main_idtf:
    [Предметная область биофильтров](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_struct;
	
-> rrel_maximum_studied_object_class:
	concept_biofilter
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[биологический фильтр] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_biological_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Биологические фильтры предназначены для очистки сточных вод с использованием биоценоза прикрепленных форм микроорганизмов.]
	                (*<-lang_ru;;*);;
                    ->[Поддерживать равномерной гидравлическую нагрузку и нагрузку по загрязняющим веществам путем изменения степени рециркуляции очищенной воды, если она предусмотрена проектной документацией, или организацией подачи сточной воды насосами с максимальной степенью равномерности при обеспечении непрерывности подачи сточных вод на фильтр.]
	                (*<-lang_ru;;*);;
                    ->[Очищать от механических примесей распределительную систему, спринклерные устройства, распределительные лотки, реактивные оросители.]
	                (*<-lang_ru;;*);;
                    ->[Не допускать чрезмерного заиливания биофильтра.]
	                (*<-lang_ru;;*);;
                    ->[Для предотвращения образования запаха, размножения насекомых и обеспечения надежной вентиляции периодически очищать и промывать пространство между дренажем и днищем биофильтра, вентиляционные отверстия и отводящие лотки от биопленки.]
	                (*<-lang_ru;;*);;
                    ->[Предотвращать попадание на загрузку биофильтра посторонних примесей.]
	                (*<-lang_ru;;*);;
                    ->[В осеннее время загрузку ограждают сеткой для предотвращения попадания листвы.]
	                (*<-lang_ru;;*);;
                    ->[При заиливании биофильтров отдельные заиленные участки разрыхляются и промываются водопроводной водой либо увеличенным расходом сточной воды из реактивного оросителя, со снижением частоты его вращения.]
	                (*<-lang_ru;;*);;
                    ->[В случае сплошного заиливания верхнего слоя биофильтра удаляют загрузочный материал на глубину от 20 до 30 см с последующей его промывкой и обратной укладкой или заменой новым загрузочным материалом.]
	                (*<-lang_ru;;*);;
                    ->[Для предотвращения заиливания допускается обрабатывать поверхность загрузки биофильтра нитратом натрия из расчета 0,4 кг/м2 загрузки.]
	                (*<-lang_ru;;*);;
                    ->[Для предотвращения размножения в загрузке насекомых допускается периодическое затопление загрузки фильтра через интервал времени от 10 до 15 суток, если это позволяет конструкция фильтра и (или) хлорирование поступающих сточных вод при содержании остаточного активного хлора от 3 до 5 мг/дм3.]
	                (*<-lang_ru;;*);;
                    ->[В холодный период для предотвращения обмерзания биофильтров их утепляют, образовавшийся на конструктивных элементах лед удаляют.]
	                (*<-lang_ru;;*);;
	        *);;
        => nrel_inclusion:
                concept_rotating_biological_contactor;;
        => nrel_inclusion:
                concept_submerged_biological_filter;;
        => nrel_inclusion:
                concept_trickling_filter;;     
	*);

-> rrel_not_maximum_studied_object_class:
        concept_trickling_filter
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[орошаемый биофильтр] (* <- lang_ru;; *);;
	*);
	concept_rotating_biological_contactor
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[ротационный биологический фильтр] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[При эксплуатации ротационных биологических фильтров обеспечивается: поддержание равномерной гидравлической нагрузки путем обеспечения равномерности и непрерывности подачи сточных вод и предотвращения остановок привода дисков или барабана фильтра.]
	                (*<-lang_ru;;*);;
                    ->[Очистка подводящих, отводящих каналов, лотков, емкостей размещения дисков или барабана от плавающих примесей и осадка, отложений по мере необходимости, но не реже 1 раза в 2 недели.]
	                (*<-lang_ru;;*);;
                    ->[Исключение чрезмерного обрастания биофильтра. Чрезмерно обросшие части биофильтра промывают струей воды при отключенном приводе.]
	                (*<-lang_ru;;*);;
	        *);;
	*);
	concept_submerged_biological_filter
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[затопленный биологический фильтр] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[При эксплуатации затопленных биологических фильтров необходимо: поддерживать равномерной гидравлическую нагрузку путем регулирования подачи исходной сточной воды в подающем трубопроводе.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать требуемую подачу воздуха в биофильтр для аэрации, в случае его эксплуатации в аэробном режиме.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать периодическую промывку загрузки биофильтра. Отключение фильтра на промывку производится при превышении потерь напора, определяемом по увеличению давления в подающем трубопроводе или при снижении эффективности очистки.]
	                (*<-lang_ru;;*);;
	        *);;
	*);
	concept_biofilm
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[биопленка] (* <- lang_ru;; *);;
	*);
	concept_sprinkler
