	*);
	concept_time_interval_of_the_pumping_process
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[временной интервал процесса перекачки] (* <- lang_ru;; *);;
	*);
	concept_preventing_interruptions_in_work
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[предотвращение перерывов в работе] (* <- lang_ru;; *);;
	*);
	concept_mechanism
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[механизм] (* <- lang_ru;; *);;
	*);
	concept_equipment
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[оборудование] (* <- lang_ru;; *);;
	*);
	concept_turning_off_treatment
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[выключение оборудования] (* <- lang_ru;; *);;
	*);
	concept_time_interval_of_the_shutdown_process
	(*
		<- sc_node_class;;
