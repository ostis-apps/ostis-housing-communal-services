		=> nrel_main_idtf:[оставленный осадок пруда] (* <- lang_ru;; *);;
	*);
	concept_thickness_of_the_remaining_pond_sediment_layer
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[толщина слоя оставленного осадка пруда] (* <- lang_ru;; *);;
	*);
	concept_ensuring_the_biological_treatment_process
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[обеспечение процесса биологической очистки] (* <- lang_ru;; *);;
	*);
	concept_sediment_treatment_on_bed
	(*
		<- sc_node_class;;
