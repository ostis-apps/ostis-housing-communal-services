subject_domain_of_processes
<- subject_domain;
<- sc_node_structure;
=> nrel_main_idtf:
	[Предметная область процессов очистных сооружений сточных вод] (* <- lang_ru;; *);

	
-> rrel_maximum_studied_object_class:
       concept_technological_process (*
    <- sc_node_class;;
    <- process;;
    => nrel_main_idtf:[технологический процесс](* <- lang_ru;; *);;
*);

-> rrel_not_maximum_studied_object_class:

   concept_biological_treatment_process (*
<- sc_node_class;;
    <= nrel_inclusion: concept_technological_process;;
    => nrel_main_idtf:[процесс биологической очистки сточных вод](* <- lang_ru;; *);;
    <= nrel_inclusion: concept_biological_treatment_facility;;
*);
concept_mechanical_treatment_process
(*
    <- sc_node_class;;
    => nrel_main_idtf:[процесс механической очистки сточных вод] (* <- lang_ru;; *);;
    <= nrel_inclusion: concept_technological_process;;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Процесс механической очистки сточных вод — совокупность операций по удалению грубодисперсных и минеральных примесей из сточных вод.] (* <- lang_ru;; *);;
        *);;
*);
concept_physicochemical_treatment_process (*
<- sc_node_class;;
  <= nrel_inclusion: concept_technological_process;;
    => nrel_main_idtf:[процесс физико-химической очистки сточных вод](* <- lang_ru;; *);;
    <= nrel_inclusion: concept_physicochemical_treatment_facility;;
*);
concept_pollutant_removal (*
    <- sc_node_class;;
     <= nrel_inclusion: concept_technological_process;;
    => nrel_main_idtf: [удаление загрязняющего вещества] (* <- lang_ru;; *);;
    => nrel_main_idtf: [pollutant removal] (* <- lang_en;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Процесс удаления загрязняющих веществ из сточных вод в ходе очистки.] (* <- lang_ru;; *);;
        *);;
*);



concept_sludge_treatment_process (*
<- sc_node_class;;
    <- concept_technological_process;;
    => nrel_main_idtf:[процесс обработки осадка](* <- lang_ru;; *);;
    <= nrel_inclusion: concept_sludge_treatment_facility;;
*);
     concept_avoidable_process
    (*
        <- sc_node_class;;
         <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[избегаемый процесс] (* <- lang_ru;; *);;
        => nrel_main_idtf:[avoidable process] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Технологический процесс или состояние, возникновения которого следует избегать при нормальной эксплуатации очистных сооружений, так как оно приводит к снижению эффективности очистки, нарушению работы оборудования или ухудшению качества очищенной воды.]
                (* <- lang_ru;; *);;
            *);;
    *);

concept_prohibited_process
    (*
        <- sc_node_class;;
         <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[недопускаемый процесс] (* <- lang_ru;; *);;
        => nrel_main_idtf:[prohibited process] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Технологический процесс или режим работы, который не допускается при эксплуатации очистных сооружений и должен быть предотвращен, так как может привести к аварийным ситуациям, повреждению оборудования или загрязнению окружающей среды.]
                (* <- lang_ru;; *);;
            *);;
    *);

concept_enabling_process
    (*
        <- sc_node_class;;
         <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[обеспечивающий процесс] (* <- lang_ru;; *);;
        => nrel_main_idtf:[enabling process] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Технологический процесс, который обеспечивает или способствует реализации основного процесса очистки сточных вод.]
                (* <- lang_ru;; *);;
            *);;
    *);
        nrel_enabling_subprocess 
        (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf: [обеспечивающий подпроцесс*] (* <- lang_ru;; *);;
    => nrel_main_idtf: [enabling subprocess*] (* <- lang_en;; *);;
    => nrel_first_domain: concept_technological_process;;
    => nrel_second_domain: concept_enabling_process;;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Отношение, связывающее технологический процесс с обеспечивающим его подпроцессом, путем которого реализуется основной процесс.]
            (* <- lang_ru;; *);;
            *);;
        *);

nrel_avoided_subprocess (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf: [избегаемый подпроцесс*] (* <- lang_ru;; *);;
    => nrel_main_idtf: [avoided subprocess*] (* <- lang_en;; *);;
    => nrel_first_domain: concept_technological_process;;
    => nrel_second_domain: concept_avoidable_process;;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Отношение, связывающее технологический процесс с подпроцессом, возникновения которого следует избегать при нормальной эксплуатации, за исключением случаев, когда
измельчение отбросов предусмотрено проектной документацией.]
            (* <- lang_ru;; *);;
            *);;
        *);

nrel_prohibited_subprocess (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf: [недопускаемый подпроцесс*] (* <- lang_ru;; *);;
    => nrel_main_idtf: [prohibited subprocess*] (* <- lang_en;; *);;
    => nrel_first_domain: concept_technological_process;;
    => nrel_second_domain: concept_prohibited_process;;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Отношение, связывающее технологический процесс с подпроцессом, который не допускается и должен быть предотвращен.]
            (* <- lang_ru;; *);;
            *);;
        *);
        
        nrel_subprocess (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf: [подпроцесс*] (* <- lang_ru;; *);;
    => nrel_main_idtf: [subprocess*] (* <- lang_en;; *);;
    => nrel_first_domain: concept_technological_process;;
    => nrel_second_domain: concept_technological_process;;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Отношение, связывающее технологический процесс с его составной частью - подпроцессом.]
            (* <- lang_ru;; *);;
            *);;
        *);
        concept_load_maintenance
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[поддержание нагрузки на оборудование] (* <- lang_ru;; *);;
        => nrel_main_idtf:[load maintenance] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс обеспечения работы оборудования в пределах его проектной пропускной способности путем регулирования количества поступающих сточных вод и включения или выключения резервных агрегатов.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "включение в работу"
concept_startup
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[включение в работу] (* <- lang_ru;; *);;
        => nrel_main_idtf:[startup] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс приведения оборудования или агрегата в рабочее состояние, начало его функционирования.]
                (* <- lang_ru;; *);;
            *);;
    *);
// Концепт "прекращение поступления сточной воды"
concept_wastewater_supply_stoppage
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[прекращение поступления сточной воды] (* <- lang_ru;; *);;
        => nrel_main_idtf:[wastewater supply stoppage] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс временного перекрытия подачи сточных вод в сооружение (септик, отстойник, нефтеловушку) путём закрытия задвижек, шиберов или отключения насосов для проведения работ по выгрузке осадка, очистки или ремонта.]
                (* <- lang_ru;; *);;
            *);;
    *);
// Концепт "выключение из работы"
concept_shutdown
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[выключение из работы] (* <- lang_ru;; *);;
        => nrel_main_idtf:[shutdown] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс прекращения работы оборудования или агрегата, вывод его из рабочего состояния.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_clarification (*
    <- sc_node_class;;
     <= nrel_inclusion: concept_technological_process;;
    => nrel_main_idtf: [осветление сточных вод] (* <- lang_ru;; *);;
    => nrel_main_idtf: [wastewater clarification] (* <- lang_en;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Процесс осветления сточных вод, при котором происходит удаление взвешенных веществ и осветление воды.]
            (* <- lang_ru;; *);;
        *);;
*);
// Концепт "задержание веществ" - процесс задержания различных примесей и загрязнителей
concept_retention (*
    <- sc_node_class;;
    <= nrel_inclusion:concept_mechanical_treatment_process;;
    => nrel_main_idtf: [задержание веществ] (* <- lang_ru;; *);;
    => nrel_main_idtf: [substances retention] (* <- lang_en;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Процесс задержания различных веществ и примесей из сточных вод.]
            (* <- lang_ru;; *);;
        *);;
        *);
        concept_inspection
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[осмотр] (* <- lang_ru;; *);;
        => nrel_main_idtf:[inspection] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Осмотр - процесс визуальной или инструментальной проверки состояния оборудования, конструкций и систем для выявления неисправностей, загрязнений или отклонений от нормальной работы.]
                (* <- lang_ru;; *);;
            *);;
    *);

concept_cleaning
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[очистка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[cleaning] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Очистка - процесс удаления загрязнений, осадка, отложений, отбросов или иных накоплений с поверхности оборудования, лотков, трубопроводов и других элементов очистных сооружений.]
                (* <- lang_ru;; *);;
            *);;
    *);

concept_excessive_accumulation
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[чрезмерное накопление] (* <- lang_ru;; *);;
        => nrel_main_idtf:[excessive accumulation] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Чрезмерное накопление - состояние, при котором количество осадка, отбросов, жира, нефтепродуктов или иных веществ в сооружении превышает допустимые нормативы, что может привести к снижению эффективности очистки, выносу загрязнений или нарушению работы оборудования.]
                (* <- lang_ru;; *);;
            *);;
    *);
// Концепт "чрезмерное повышение"
concept_excessive_increase
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[чрезмерное повышение] (* <- lang_ru;; *);;
        => nrel_main_idtf:[excessive increase] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс недопустимого увеличения значения параметра (уровня сточной воды, влажности осадка, потерь напора и др.) сверх установленных нормативов, требующий принятия корректирующих мер.]
                (* <- lang_ru;; *);;
            *);;
    *);
concept_monitoring_of_cleanliness_and_serviceability
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[наблюдение за чистотой и исправностью] (* <- lang_ru;; *);;
        => nrel_main_idtf:[monitoring of cleanliness and serviceability] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Наблюдение за чистотой и исправностью - процесс постоянного контроля состояния распределительных и сборных лотков, нефтесборных труб, водосливов, механизмов для сгребания и удаления осадка, оборудования и систем для своевременного выявления загрязнений, неисправностей и отклонений от нормальной работы.]
                (* <- lang_ru;; *);;
            *);;
    *);
    
    concept_sludge_storage
    (*
        <- sc_node_class;;
         <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[хранение осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge storage] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Хранение осадка - процесс накопления осадка в сооружении (септике, двухъярусном отстойнике) в межремонтный период до его выгрузки.]
                (* <- lang_ru;; *);;
            *);;
    *);

concept_sludge_fermentation
    (*
        <- sc_node_class;;
         <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[сбраживание осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge fermentation] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Сбраживание осадка - анаэробный процесс разложения органических веществ в осадке микроорганизмами, происходящий в септиках и двухъярусных отстойниках.]
                (* <- lang_ru;; *);;
            *);;
    *);
    
    concept_preliminary_clarification
    (*
        <- sc_node_class;;
         <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[предварительное осветление сточных вод] (* <- lang_ru;; *);;
        => nrel_main_idtf:[preliminary clarification] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Предварительное осветление сточных вод- процесс удаления взвешенных веществ из сточных вод перед их поступлением на биологическую или физико-химическую очистку.]
                (* <- lang_ru;; *);;
            *);;
    *);
    
    concept_uniform_wastewater_distribution
    (*
        <- sc_node_class;;
        <= nrel_inclusion:concept_mechanical_treatment_process;;
        => nrel_main_idtf:[равномерное распределение сточных вод между сооружениями] (* <- lang_ru;; *);;
        => nrel_main_idtf:[uniform wastewater distribution between facilities] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс обеспечения одинакового расхода сточных вод, поступающих в каждое параллельно работающее очистное сооружение или секцию, для предотвращения перегрузки одних и недогрузки других.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_inspection_and_cleaning
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[осмотр и очистка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[inspection and cleaning] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Комплекс мероприятий по визуальному или инструментальному контролю состояния сооружения и удалению накопившихся загрязнений, осадка, отложений, жиров, нефтепродуктов и отбросов.]
                (* <- lang_ru;; *);;
            *);;
        <= nrel_inclusion: concept_inspection;;
       <= nrel_inclusion: concept_cleaning;;
    *);
    // Отношение "определяется с помощью"

    // Концепт "выгрузка осадка"
concept_sludge_discharge
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[выгрузка осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge discharge] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс удаления накопившегося осадка из отстойников, септиков, нефтеловушек, жироловок и других сооружений механической очистки.]
                (* <- lang_ru;; *);;
            *);;
    *);
    // Концепт "промывка"
    // Концепт "время пребывания"
concept_retention_time
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_indicator;;
        => nrel_main_idtf:[время пребывания] (* <- lang_ru;; *);;
        => nrel_main_idtf:[retention time] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Продолжительность нахождения сточных вод в сооружении, за которую происходит осаждение взвешенных веществ или протекают другие процессы очистки.]
                (* <- lang_ru;; *);;
            *);;
        => rrel_has_unit:[ч];;
    *);
    // Концепт "снижение"
concept_reduction
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[снижение] (* <- lang_ru;; *);;
        => nrel_main_idtf:[reduction] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс уменьшения значения параметра, концентрации загрязняющих веществ или уровня в результате очистки или регулирования.]
                (* <- lang_ru;; *);;
            *);;
    *);

concept_replacement
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[замена] (* <- lang_ru;; *);;
        => nrel_main_idtf:[replacement] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс удаления вышедших из строя или изношенных деталей, узлов или элементов оборудования и установки новых взамен них.]
                (* <- lang_ru;; *);;
            *);;
    *);
    // Концепт "предотвращение засорения"
concept_clogging_prevention
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[предотвращение засорения] (* <- lang_ru;; *);;
        => nrel_main_idtf:[clogging prevention] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Комплекс мер и действий по недопущению засорения трубопроводов, насадок и других элементов оборудования очистных сооружений.]
                (* <- lang_ru;; *);;
            *);;
    *);
  concept_monitoring
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[мониторинг] (* <- lang_ru;; *);;
        => nrel_main_idtf:[monitoring] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Мониторинг - систематический процесс сбора, анализа и оценки данных о параметрах работы очистных сооружений, качестве сточных вод и состоянии окружающей среды для своевременного выявления отклонений и принятия управленческих решений.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_flushing
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[промывка] (* <- lang_ru;; *);;
