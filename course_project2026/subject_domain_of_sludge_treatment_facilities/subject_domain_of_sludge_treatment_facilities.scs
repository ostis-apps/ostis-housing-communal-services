subject_domain_of_sludge_treatment_facilities

=> nrel_main_idtf:
    [Предметная область сооружений обработки осадка] (* <- lang_ru;; *);
<- subject_domain;
<- sc_node_structure;

-> rrel_maximum_studied_object_class:
    concept_sludge_treatment_facility
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[сооружение обработки осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge treatment facility] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Сооружения обработки осадков сточных вод применяются с целью их уплотнения стабилизации обеззараживания кондиционирования обезвоживания сушки термического разложения органических веществ осадка.] (* <- lang_ru;; *);;
            *);;
    *);

