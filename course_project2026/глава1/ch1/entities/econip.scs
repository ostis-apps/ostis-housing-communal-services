econip
<- concept_ec;
=> nrel_main_idtf:
    [ЭкоНиП 17.06.06-005-2022]
    (*
        <- lang_ru;;
    *);
-> nrel_law:
    water_code_ref;
    environmental_protection_law_ref;
    waste_management_law_ref;
    air_protection_law_ref;
    measurement_unity_law_ref;
    construction_activity_law_ref;;

water_code_ref
=> nrel_main_idtf:
    [Водный кодекс Республики Беларусь]
