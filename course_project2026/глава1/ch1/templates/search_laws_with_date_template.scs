@search_laws_with_date_template = {
    // Шаг 1: Найти все законы ЭкоНиП
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._ec <-_ concept_ec);;
            nrel_law _-> (.._ec _=> .._law);;
            @output_param1 = (.._law <-_ concept_law);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *);
    
    // Шаг 2: Для каждого закона найти дату его принятия
    rrel_next_template: {
        rrel_template: [*
            @input_param1 = (.._law <-_ concept_law);;
            nrel_data _-> (.._law _=> .._data);;
            @output_param1 = (.._data <-_ lang_ru);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *)
};;

@search_laws_with_date_template
    <- nrel_fixed_search_strategy_template;
    => nrel_main_idtf:
        [Шаблон поиска законов ЭкоНиП с датами их принятия]
        (*
            <- lang_ru;;
        *);;
