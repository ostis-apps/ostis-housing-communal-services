subject_domain_of_wastewater_treatment_facilities
<- subject_domain;
<- sc_node_structure;
=> nrel_main_idtf:
	[Предметная область очистных сооружений сточных вод] (* <- lang_ru;; *);

// Частные предметные области (дочерние)
=> nrel_private_subject_domain:
	
	subject_domain_of_mechanical_wastewater_treatment_facility;
	subject_domain_of_biological_wastewater_treatment_facility;
	subject_domain_of_physicochemical_wastewater_treatment_facility;
	subject_domain_of_sludge_treatment_facilities;
	
-> rrel_maximum_studied_object_class:
    concept_wastewater_treatment_facility
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[очистное сооружение сточных вод] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Очистные сооружения сточных вод представляют собой комплекс гидротехнических сооружений и устройств, предназначенный для очистки сточных вод и обработки осадка.] (* <- lang_ru;; *);;
            *);;
    *);

-> rrel_not_maximum_studied_object_class:
    
    concept_wastewater
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[сточные воды] (* <- lang_ru;; *);;
        => nrel_main_idtf:[wastewater] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Сточные воды — воды, отводимые с территории населенных пунктов и промышленных предприятий после использования.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_treated_wastewater
    (*
        <- concept_wastewater;;
        => nrel_main_idtf:[очищенные сточные воды] (* <- lang_ru;; *);;
        => nrel_main_idtf:[treated wastewater] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Очищенные сточные воды — сточные воды, прошедшие очистку на очистных сооружениях и сбрасываемые в окружающую среду.] (* <- lang_ru;; *);;
            *);;
    *);
concept_surface_wastewater
    (*
        <- concept_wastewater;;
        => nrel_main_idtf:[поверхностные сточные воды] (* <- lang_ru;; *);;
        => nrel_main_idtf:[surface wastewater] (* <- lang_en;; *);;
          <= nrel_inclusion: concept_wastewater;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Поверхностные сточные воды — воды, образующиеся в результате выпадения атмосферных осадков (дождевые, талые воды), а также воды от полива территорий и мытья улиц, требующие очистки перед сбросом в водные объекты.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "производственные сточные воды"
concept_industrial_wastewater
    (*
        <- concept_wastewater;;
        => nrel_main_idtf:[производственные сточные воды] (* <- lang_ru;; *);;
        => nrel_main_idtf:[industrial wastewater] (* <- lang_en;; *);;
         <= nrel_inclusion: concept_wastewater;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Производственные сточные воды — воды, образующиеся в результате технологических процессов промышленных предприятий, содержащие специфические загрязняющие вещества, характерные для данного вида производства.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_pipeline
(*
    <- sc_node_class;;
    => nrel_main_idtf:[трубопровод] (* <- lang_ru;; *);;
    => nrel_main_idtf:[pipeline] (* <- lang_en;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Трубопровод - инженерное сооружение для транспортировки жидкостей газов и сыпучих материалов.] (* <- lang_ru;; *);;
        *);;
    <= nrel_subdividing: concept_supply_pipeline; concept_outlet_pipeline; concept_sludge_pipeline; concept_gas_pipeline; concept_air_pipeline;;
*);

concept_supply_pipeline
(*
    <- sc_node_class;;
    => nrel_main_idtf:[подводящий трубопровод] (* <- lang_ru;; *);;
    => nrel_main_idtf:[supply pipeline] (* <- lang_en;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Подводящий трубопровод - трубопровод для подачи сточных вод на очистные сооружения.] (* <- lang_ru;; *);;
        *);;
*);

concept_outlet_pipeline
(*
    <- sc_node_class;;
    => nrel_main_idtf:[отводящий трубопровод] (* <- lang_ru;; *);;
    => nrel_main_idtf:[outlet pipeline] (* <- lang_en;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Отводящий трубопровод - трубопровод для отвода очищенной воды.] (* <- lang_ru;; *);;
        *);;
*);
    concept_pollutant
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[загрязняющее вещество] (* <- lang_ru;; *);;
        => nrel_main_idtf:[pollutant] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Загрязняющие вещества — компоненты сточных вод, подлежащие удалению в процессе очистки.] (* <- lang_ru;; *);;
            *);;
    *);

concept_waste
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_pollutant;;
        => nrel_main_idtf:[отбросы] (* <- lang_ru;; *);;
        => nrel_main_idtf:[waste] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Крупные нерастворимые примеси, задерживаемые на решётках и ситах в процессе процеживания сточных вод, подлежащие сбору в контейнеры, обезвреживанию и удалению.]
                (* <- lang_ru;; *);;
            *);;
    *);
concept_suspended_solids (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[взвешенные вещества](* <- lang_ru;; *);;
*);


concept_sand (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[песок](* <- lang_ru;; *);;
*);



concept_surfactants (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[СПАВ](* <- lang_ru;; *);;
*);

concept_grease (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[жиры](* <- lang_ru;; *);;
*);


concept_heavy_metals (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[тяжелые металлы](* <- lang_ru;; *);;
*);


concept_bod5 (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[БПК5](* <- lang_ru;; *);;
*);

concept_cod (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[ХПК](* <- lang_ru;; *);;
*);

concept_phosphorus (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[фосфор общий](* <- lang_ru;; *);;
*);

concept_nitrogen (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[азот общий](* <- lang_ru;; *);;
*);

concept_ammonium (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[аммоний-ионы](* <- lang_ru;; *);;
*);

concept_nitrites (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[нитрит-ионы](* <- lang_ru;; *);;
*);

concept_nitrates (*
<- sc_node_class;;
	 <= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[нитрат-ионы](* <- lang_ru;; *);;
*);

concept_coliform_bacteria (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[общие колиформные бактерии](* <- lang_ru;; *);;
*);


concept_coliphages (*
<- sc_node_class;;
	<= nrel_inclusion: concept_pollutant;;
	=> nrel_main_idtf:[колифаги](* <- lang_ru;; *);;
*);

concept_sludge
(*
    <- sc_node_class;;
    => nrel_main_idtf:[осадок сточных вод] (* <- lang_ru;; *);;
    => nrel_main_idtf:[sludge] (* <- lang_en;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Осадок сточных вод — твёрдая фракция, образующаяся в процессе очистки сточных вод на различных этапах.] (* <- lang_ru;; *);;
        *);;
*);
concept_accumulated_pollutant
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_pollutant;;
        => nrel_main_idtf:[накопленное загрязняющее вещество] (* <- lang_ru;; *);;
        => nrel_main_idtf:[accumulated pollutant] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Накопленное загрязняющее вещество - осадок, песок, отбросы, нефтепродукты, жиры и другие примеси, оседающие или всплывающие в очистных сооружениях и подлежащие периодическому удалению.]
                (* <- lang_ru;; *);;
            *);;
    *);
    
concept_sludge_treatment_process (*
<- sc_node_class;;
    <- concept_technological_process;;
    => nrel_main_idtf:[процесс обработки осадка](* <- lang_ru;; *);;
    <= nrel_inclusion: concept_sludge_treatment_facility;;
*);
concept_indicator (*
	<- sc_node_class;;
	=> nrel_main_idtf:[показатель технологического режима работы очистных сооружений механической очистки](* <- lang_ru;; *);;
<= nrel_inclusion:
   concept_measurement_parameter;;
=> nrel_definition:
   [Технологический показатель — это количественная или качественная характеристика технологического процесса, используемая для оценки режима работы и эффективности очистки сточных вод.]
   (* <- lang_ru;; *);;
*);


concept_temperature (*
	 <= nrel_inclusion: concept_indicator;;
	=> nrel_main_idtf:[температура](* <- lang_ru;; *);;
	=> nrel_has_unit:[°C](* <- lang_ru;; *);;
	<= nrel_inclusion: concept_indicator;;
*);

concept_frequency (*
    <- sc_node_class;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf: [периодичность] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Характеристика процесса или действия, определяющая интервал времени между его повторениями.] (* <- lang_ru;; *);;
        *);;
        *);
// (переиспользуются в механической, биологической и физико-химической очистке)

// Используется: песколовки, биофильтры, фильтры, биологические пруды


concept_hydraulic_load (*
	 <- sc_node_class;;
	<= nrel_inclusion: concept_indicator;;
	=> nrel_main_idtf:[гидравлическая нагрузка](* <- lang_ru;; *);;
	=> nrel_has_unit:[м³/(м²·ч)](* <- lang_ru;; *);;
*);


// Используется: первичные отстойники, двухъярусные отстойники, септики,
//                фильтры, гидроциклоны, биофильтры, вторичные отстойники,
//                биологические пруды

concept_suspended_solids_in_effluent (*
	 <- sc_node_class;;
	<= nrel_inclusion: concept_indicator;;
	=> nrel_main_idtf:[содержание взвешенных веществ в осветленной воде](* <- lang_ru;; *);;
	=> nrel_has_unit:[мг/дм³](* <- lang_ru;; *);;
*);
concept_suspended_solids (*
	 <- sc_node_class;;
	<= nrel_inclusion: concept_indicator;;
	=> nrel_main_idtf:[содержание взвешенных веществ](* <- lang_ru;; *);;
	=> nrel_has_unit:[мг/дм³](* <- lang_ru;; *);;
*);

// Используется: первичные отстойники, двухъярусные отстойники, фильтры,
//                биофильтры, биологические пруды

concept_bod5_in_effluent (*
	 <- sc_node_class;;
	<= nrel_inclusion: concept_indicator;;
	=> nrel_main_idtf:[БПК5 в осветленной воде](* <- lang_ru;; *);;
	=> nrel_has_unit:[мгО₂/дм³](* <- lang_ru;; *);;
*);


concept_wash_water_volume (*
 <- sc_node_class;;
	<= nrel_inclusion: concept_indicator;;
	=> nrel_main_idtf:[объем промывной воды](* <- lang_ru;; *);;
	=> nrel_has_unit:[м³](* <- lang_ru;; *);;
*);

concept_treatment_facility_operation  (*
=> nrel_main_idtf:
   [эксплуатация очистного сооружения] (* <- lang_ru;; *);;
<- sc_node_class;;
<= nrel_inclusion: concept_technological_process;;
=> nrel_definition:
   [Эксплуатация очистного сооружения — это процесс функционирования, обслуживания и управления очистным сооружением, направленный на обеспечение его надежной работы и достижения требуемой эффективности очистки сточных вод.] (* <- lang_ru;; *);;
   *);
   
concept_operating_mode (*
    <- sc_node_class;;
    => nrel_main_idtf:[режим эксплуатации](* <- lang_ru;; *);;
    => nrel_main_idtf:[operating mode](* <- lang_en;; *);;
*);

concept_sludge_removal_mode (*
    <- concept_operating_mode;;
    => nrel_main_idtf:[режим удаления осадка](* <- lang_ru;; *);;
    <= nrel_inclusion: concept_operating_mode;;
*);

concept_backwash_mode (*
    <- concept_operating_mode;;
    => nrel_main_idtf:[режим промывки](* <- lang_ru;; *);;
    <= nrel_inclusion: concept_operating_mode;;
*);

concept_aeration_mode (*
    <- concept_operating_mode;;
    => nrel_main_idtf:[режим аэрации](* <- lang_ru;; *);;
    <= nrel_inclusion: concept_operating_mode;;
*);

    // Концепт "продолжительность"
concept_duration
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_indicator;;
        => nrel_main_idtf:[продолжительность] (* <- lang_ru;; *);;
        => nrel_main_idtf:[duration] (* <- lang_en;; *);;
        => nrel_has_unit:[ч];;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Временной интервал, в течение которого выполняется процесс, операция или сохраняется определённое состояние.]
                (* <- lang_ru;; *);;
            *);;
    *);
   
-> rrel_explored_relation:

nrel_contains_pollutant (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[содержит загрязняющее вещество](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_wastewater;;
	=> nrel_second_domain: concept_pollutant;;
*);

nrel_has_parameter (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[характеризуется показателем](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_wastewater_treatment_facility;;
	=> nrel_second_domain: concept_indicator;;
*);

nrel_is_treated_by (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[очищается на сооружении](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_wastewater;;
	=> nrel_second_domain: concept_wastewater_treatment_facility;;
*);

nrel_discharged_to (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[сбрасывается в](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_treated_wastewater;;
	=> nrel_second_domain: concept_environment;;
*);

nrel_removes_substance (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[удаляет вещество](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_wastewater_treatment_facility;;
	=> nrel_second_domain: concept_pollutant;;
*);

nrel_produces_sludge (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[образует осадок](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_wastewater_treatment_facility;;
	=> nrel_second_domain: concept_sludge;;
*);


nrel_has_operating_mode (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[имеет режим эксплуатации](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_wastewater_treatment_facility;;
	=> nrel_second_domain: concept_operating_mode;;
*);

nrel_requires_monitoring (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[требует контроля](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_wastewater_treatment_facility;;
	=> nrel_second_domain: concept_indicator;;
*);

nrel_has_unit (*
	<- sc_node_non_role_relation;;
	=> nrel_main_idtf:[имеет единицу измерения](* <- lang_ru;; *);;
	=> nrel_first_domain: concept_indicator;;
	=> nrel_second_domain: sc_node_class;;
*);

nrel_min_value
    (*
        <- sc_node_non_role_relation;;
        => nrel_main_idtf:[минимальная величина*] (* <- lang_ru;; *);;
        => nrel_main_idtf:[minimum value*] (* <- lang_en;; *);;
        => nrel_first_domain: concept_indicator;;
        => nrel_second_domain: concept_numeric_value;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Отношение, связывающее показатель с его минимальным допустимым числовым значением.]
                (* <- lang_ru;; *);;
            *);;
    *);

nrel_max_value
    (*
        <- sc_node_non_role_relation;;
        => nrel_main_idtf:[максимальная величина*] (* <- lang_ru;; *);;
        => nrel_main_idtf:[maximum value*] (* <- lang_en;; *);;
        => nrel_first_domain: concept_indicator;;
        => nrel_second_domain: concept_numeric_value;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Отношение, связывающее показатель с его максимальным допустимым числовым значением.]
                (* <- lang_ru;; *);;
            *);;
    *);
        
// Отношение "удаляемое вещество" - связывает процесс удаления с конкретным загрязняющим вещество
        
        nrel_is_intended_for (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf: [предназначен для*] (* <- lang_ru;; *);;
    => nrel_main_idtf: [is intended for*] (* <- lang_en;; *);;
    => nrel_first_domain: concept_wastewater_treatment_facility;;
    => nrel_second_domain: concept_technological_process;;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Отношение, связывающее очистное сооружение с технологическим процессом, для выполнения которого это сооружение предназначено.]
            (* <- lang_ru;; *);;
        *);;
        *);
        
       

// Отношение "задерживаемое вещество" - связывает процесс задержания с конкретным веществом
nrel_retained_substance (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf: [задерживаемое вещество*] (* <- lang_ru;; *);;
    => nrel_main_idtf: [retained substance*] (* <- lang_en;; *);;
    => nrel_first_domain: concept_substances_retention;;
    => nrel_second_domain: concept_pollutant;;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Отношение, связывающее процесс задержания с веществом, которое задерживается в ходе процесса.]
            (* <- lang_ru;; *);;
        *);;
        *);
        concept_avoidable_process
    (*
        <- sc_node_class;;
         <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[избегаемый процесс] (* <- lang_ru;; *);;
        => nrel_main_idtf:[avoidable process] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Технологический процесс или состояние, возникновения которого следует избегать при нормальной эксплуатации очистных сооружений, так как оно приводит к снижению эффективности очистки, нарушению работы оборудования или ухудшению качества очищенной воды.]
                (* <- lang_ru;; *);;
            *);;
    *);



    // Отношение "определяется с помощью"
nrel_is_determined_by
    (*
        <- sc_node_non_role_relation;;
        => nrel_main_idtf:[определяется с помощью*] (* <- lang_ru;; *);;
        => nrel_main_idtf:[is determined by*] (* <- lang_en;; *);;
        => nrel_first_domain: sc_node_class;;
        => nrel_second_domain: sc_node_class;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Отношение, связывающее любую сущность с методом, средством, способом или инструментом её определения, измерения, оценки или выявления.]
                (* <- lang_ru;; *);;
            *);;
    *);
concept_retention_time
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_indicator;;
        => nrel_main_idtf:[время пребывания] (* <- lang_ru;; *);;
        => nrel_main_idtf:[retention time] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Продолжительность нахождения сточных вод в сооружении, за которую происходит осаждение взвешенных веществ или протекают другие процессы очистки.]
                (* <- lang_ru;; *);;
            *);;
        => nrel_has_unit:[ч];;
    *);
    // Концепт "снижение"
concept_reduction
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[снижение] (* <- lang_ru;; *);;
        => nrel_main_idtf:[reduction] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс уменьшения значения параметра, концентрации загрязняющих веществ или уровня в результате очистки или регулирования.]
                (* <- lang_ru;; *);;
            *);;
    *);
   nrel_enabling
    (*
        <- sc_node_non_role_relation;;
        => nrel_main_idtf:[обеспечивается*] (* <- lang_ru;; *);;
        => nrel_main_idtf:[is ensured by*] (* <- lang_en;; *);;
        => nrel_first_domain: concept_technological_process;;
        => nrel_second_domain: sc_node_class;;
    *);;
   
    
     
    
 

        
        
