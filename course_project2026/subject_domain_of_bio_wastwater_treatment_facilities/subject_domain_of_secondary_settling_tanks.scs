subject_domain_of_secondary_settling_tanks

=> nrel_main_idtf:
    [Предметная область вторичных отстойников](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_secondary_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[вторичный отстойник] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_biological_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Вторичные отстойники предназначены для разделения иловой смеси и очищенной сточной воды и (или) отделения биопленки.]
	                (*<-lang_ru;;*);;
                    ->[При отведении сточной воды со вторичных отстойников на сооружения последующей очистки, концентрация взвешенных веществ в сточной воде, отводимой от вторичных отстойников, должна обеспечивать технологический режим эксплуатации сооружений последующего этапа очистки и не приводить к их чрезмерной перегрузке.]
	                (*<-lang_ru;;*);;
                    ->[При эксплуатации вторичных отстойников необходимо обеспечить режим удаления активного ила для предотвращения нежелательной денитрификации и выноса осадка в осветленную воду образующимися газами, а также обратного перехода соединений фосфора в очищенную сточную воду.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечить режим подачи рециркуляционного ила из вторичного отстойника в аэротенки со степенью рециркуляции активного ила, установленной в проектной документации, в сооружения с нитрификацией и денитрификацией со степенью рециркуляции активного ила не менее 0,5.]
	                (*<-lang_ru;;*);;
                    ->[Рекомендуемая продолжительность нахождения осадка во вторичном отстойнике зависит от вида биологической очистки и составляет для сооружений без нитрификации от 1,5 до 2,0 ч, для сооружений с нитрификацией от 1,0 до 1,5 ч, сооружений с денитрификацией от 2,0 до 2,5 ч.]
	                (*<-lang_ru;;*);;
                    ->[Продолжительность пребывания осадка в зоне уплотнения не должна превышать 40 минут, для предотвращения его загнивания и снижения активности.]
	                (*<-lang_ru;;*);;
                    ->[Степень рециркуляции активного ила при использовании горизонтальных и радиальных вторичных отстойников рекомендуется не более 1,0, для вертикальных отстойников – не более 1,5.]
	                (*<-lang_ru;;*);;
                    ->[Опорожнение вторичных отстойников для проведения технического обслуживания производится не реже 1 раза в 2 года.]
	                (*<-lang_ru;;*);;
	        *);;
        <= nrel_subdividing:
                concept_horizontal_secondary_settling_tank;
                concept_radial_secondary_settling_tank;
                concept_vertical_secondary_settling_tank;;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_horizontal_secondary_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[горизонтальный вторичный отстойник] (* <- lang_ru;; *);;
	*);
	concept_radial_secondary_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[радиальный вторичный отстойник] (* <- lang_ru;; *);;
	*);
	concept_vertical_secondary_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[вертикальный вторичный отстойник] (* <- lang_ru;; *);;
	*);
	concept_recirculated_activated_sludge
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[рециркуляционный активный ил] (* <- lang_ru;; *);;
	*);
	concept_recirculation_rate
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[степень рециркуляции] (* <- lang_ru;; *);;
	*);
	concept_sludge_compaction_zone
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[зона уплотнения осадка] (* <- lang_ru;; *);;
	*);
	concept_biofilm_separation
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[отделение биопленки] (* <- lang_ru;; *);;
	*);
	concept_denitrification_in_secondary_settler
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[нежелательная денитрификация во вторичном отстойнике] (* <- lang_ru;; *);;
	*);
	concept_phosphorus_release
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[обратный переход соединений фосфора] (* <- lang_ru;; *);;
	*);;
