subject_domain_of_grease_traps

=> nrel_main_idtf:
    [Предметная область жироловителей] (* <- lang_ru;; *);
<- subject_domain;
<- sc_node_structure;

-> rrel_maximum_studied_object_class:
    concept_grease_trap
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[жироловитель] (* <- lang_ru;; *);;
        => nrel_main_idtf:[grease trap] (* <- lang_en;; *);;
        => nrel_has_parameter: concept_grease_volume;;
        => nrel_has_parameter: concept_sludge_volume;;
        => nrel_has_parameter: concept_grease_content_in_effluent;;
        => rrel_has_part: concept_working_chamber;;
        <= nrel_inclusion: concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Жироловители предназначены для осветления сточных вод и удаления из них жиров.] (* <- lang_ru;; *);;
                -> [Осуществлять своевременное удаление задержанных жира и осадка по мере их накопления.] (* <- lang_ru;; *);;
                -> [Очищать подводящие и отводящие трубопроводы от осадков и жировых отложений.] (* <- lang_ru;; *);;
                -> [Рекомендуется производить удаление жира при толщине его слоя в рабочей камере жироуловителя более 0,2 м.] (* <- lang_ru;; *);;
                -> [Рекомендуется производить удаление осадка при его накоплении в жироуловителе более 30 процентов от объема рабочей камеры но не реже чем 1 раз в год.] (* <- lang_ru;; *);;
                -> [После удаления задержанных жира и осадка из жироуловителей и перед повторным включением в работу их рабочий объем заполняют водой не содержащей жировых примесей.] (* <- lang_ru;; *);;
            *);;
    *);

-> rrel_not_maximum_studied_object_class:

    concept_working_chamber
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[рабочая камера] (* <- lang_ru;; *);;
        => nrel_main_idtf:[working chamber] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Рабочая камера - основная емкость жироловителя в которой происходит осаждение жиров и осадка.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_inlet_pipeline
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[подводящий трубопровод] (* <- lang_ru;; *);;
        => nrel_main_idtf:[inlet pipeline] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Подводящий трубопровод - трубопровод для подачи сточных вод в жироловитель.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_outlet_pipeline
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[отводящий трубопровод] (* <- lang_ru;; *);;
        => nrel_main_idtf:[outlet pipeline] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Отводящий трубопровод - трубопровод для отвода осветленной воды из жироловителя.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_grease
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[жир] (* <- lang_ru;; *);;
        => nrel_main_idtf:[grease] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Жир - загрязняющее вещество органического происхождения удаляемое из сточных вод в жироловителях.] (* <- lang_ru;; *);;
            *);;
    *);

concept_retained_grease_and_sludge
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[задержанные жир и осадок] (* <- lang_ru;; *);;
        => nrel_main_idtf:[retained grease and sludge] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Задержанные жир и осадок - жировые вещества и твердые отложения, выделенные из сточных вод в жироловках накапливающиеся в рабочей камере и подлежащие своевременному удалению.]
                (* <- lang_ru;; *);;
            *);;
    *);
concept_accumulation_in_working_chamber
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[накопление в рабочей камере] (* <- lang_ru;; *);;
        => nrel_main_idtf:[accumulation in working chamber] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс постепенного увеличения количества осадка, жира или других загрязнений в рабочей камере жироловки в процессе эксплуатации.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_grease_removal_mode
    (*
        <- concept_operating_mode;;
        => nrel_main_idtf:[режим удаления жира] (* <- lang_ru;; *);;
        => nrel_main_idtf:[grease removal mode] (* <- lang_en;; *);;
    *);

    concept_sludge_removal_mode
    (*
        <- concept_operating_mode;;
        => nrel_main_idtf:[режим удаления осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge removal mode] (* <- lang_en;; *);;
    *);

    concept_wash_water
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[вода для заполнения] (* <- lang_ru;; *);;
        => nrel_main_idtf:[fill water] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Вода для заполнения - вода не содержащая жировых примесей используемая для заполнения рабочего объема жироловителя после удаления жира и осадка.] 
                (* <- lang_ru;; *);; 
            *);;
    *);

    concept_grease_layer
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[слой жира] (* <- lang_ru;; *);;
        => nrel_main_idtf:[grease layer] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Слой жира - скопление жира на поверхности воды в рабочей камере жироловителя.] (* <- lang_ru;; *);;
            *);;
    *);

// Показатели
concept_grease_volume
(*
     <- sc_node_class;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[объем задержанного жира] (* <- lang_ru;; *);;
    => nrel_main_idtf:[grease volume] (* <- lang_en;; *);;
    => rrel_has_unit:[м³] (* <- lang_ru;; *);;
*);

concept_sludge_volume
(*
      <- sc_node_class;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[объем осадка] (* <- lang_ru;; *);;
    => nrel_main_idtf:[sludge volume] (* <- lang_en;; *);;
    => rrel_has_unit:[м³] (* <- lang_ru;; *);;
*);

concept_grease_content_in_effluent
(*
     <- sc_node_class;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[содержание жиров в осветленной воде] (* <- lang_ru;; *);;
    => nrel_main_idtf:[grease content in effluent] (* <- lang_en;; *);;
    => rrel_has_unit:[мг/дм³] (* <- lang_ru;; *);;
*);

concept_grease_layer_thickness
(*
      <- sc_node_class;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[толщина слоя жира] (* <- lang_ru;; *);;
    => nrel_main_idtf:[grease layer thickness] (* <- lang_en;; *);;
    => rrel_has_unit:[м] (* <- lang_ru;; *);;
*);;




