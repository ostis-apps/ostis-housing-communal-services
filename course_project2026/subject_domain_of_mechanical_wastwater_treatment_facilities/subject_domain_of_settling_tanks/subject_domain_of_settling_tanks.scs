subject_domain_of_settling_tanks

=> nrel_main_idtf:
    [Предметная область отстойников] (* <- lang_ru;; *);
<- subject_domain;
<- sc_node_structure;

-> rrel_maximum_studied_object_class:
    concept_settling_tank
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[отстойник] (* <- lang_ru;; *);;
        => nrel_main_idtf:[settling tank] (* <- lang_en;; *);;
        => nrel_has_parameter: concept_sludge_volume;;
        => nrel_has_parameter: concept_sludge_moisture;;
        => nrel_has_parameter: concept_sludge_chemical_composition;;
        => nrel_has_parameter: concept_suspended_solids_in_effluent;;
        => nrel_has_parameter: concept_bod5_in_effluent;;
       => nrel_has_parameter: concept_settling_duration;;
        <= nrel_inclusion: concept_mechanical_wastewater_treatment_facility;;
        <= nrel_subdividing: concept_primary_settling_tank; concept_two_tier_settling_tank;;
    *);

-> rrel_not_maximum_studied_object_class:

    concept_primary_settling_tank
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[первичный отстойник] (* <- lang_ru;; *);;
        => nrel_main_idtf:[primary settling tank] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
    (*
        <- concept_definition (*<- sc_node_class;;*);;
        -> [Первичный отстойник — отстойник, в котором сточная вода осветляется перед подачей на биологическую или физико-химическую очистку.] (* <- lang_ru;; *);;
    *);;
        <= nrel_subdividing:
        {
concept_vertical_settling_tank; 
concept_radial_settling_tank; 
concept_horizontal_settling_tank
};;
    *);

    concept_two_tier_settling_tank
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[двухъярусный отстойник] (* <- lang_ru;; *);;
        => nrel_main_idtf:[two tier settling tank] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
    (*
        <- concept_definition (*<- sc_node_class;;*);;
        -> [Двухъярусный отстойник — отстойник, состоящий из верхней (отстойной) и нижней (иловой) камер, в которой сбраживается осадок.] (* <- lang_ru;; *);;
    *);;
    *);

    concept_vertical_settling_tank
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[вертикальный отстойник] (* <- lang_ru;; *);;
        => nrel_main_idtf:[vertical settling tank] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Вертикальный отстойник - отстойник с вертикальным движением воды в котором осадок опускается на дно под действием силы тяжести.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_radial_settling_tank
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[радиальный отстойник] (* <- lang_ru;; *);;
        => nrel_main_idtf:[radial settling tank] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Радиальный отстойник - отстойник с радиальным движением воды от центра к периферии обеспечивающий высокую эффективность осветления.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_horizontal_settling_tank
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[горизонтальный отстойник] (* <- lang_ru;; *);;
        => nrel_main_idtf:[horizontal settling tank] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Горизонтальный отстойник - отстойник с горизонтальным движением воды в котором взвешенные вещества выпадают в осадок при движении потока от входного устройства к выходному.] (* <- lang_ru;; *);;
            *);;
    *);
// Концепт "время пребывания"
concept_retention_time
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_indicator;;
        => nrel_main_idtf:[время пребывания] (* <- lang_ru;; *);;
        => nrel_main_idtf:[retention time] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Продолжительность нахождения сточных вод в сооружении, за которую происходит осаждение взвешенных веществ или протекают другие процессы очистки.]
                (* <- lang_ru;; *);;
            *);;
        => nrel_has_unit:[ч];;
    *);
    
    concept_raw_sludge
    (*
        <- concept_sludge;;
        => nrel_main_idtf:[сырой осадок] (* <- lang_ru;; *);;
        => nrel_main_idtf:[raw sludge] (* <- lang_en;; *);;
    *);

    concept_digested_sludge
    (*
        <- concept_sludge;;
        => nrel_main_idtf:[сброженный осадок] (* <- lang_ru;; *);;
        => nrel_main_idtf:[digested sludge] (* <- lang_en;; *);;
    *);

    concept_floating_impurities
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[плавающие примеси] (* <- lang_ru;; *);;
        => nrel_main_idtf:[floating impurities] (* <- lang_en;; *);;
    *);

  // Концепт "задвижка"
concept_gate_valve
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[задвижка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[gate valve] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Запорное устройство для перекрытия потока сточных вод в трубопроводах.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "илоскреб"
concept_sludge_scraper
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[илоскреб] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge scraper] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Механизм для сгребания осадка со дна отстойника к приямку.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "илосос"
concept_sludge_sucker
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[илосос] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge sucker] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Устройство для откачки жидкого осадка из приямков и отстойников.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "шибер"
concept_sluice_gate
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[шибер] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sluice gate] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Регулирующее и запорное устройство для управления потоком воды в лотках и каналах.]
                (* <- lang_ru;; *);;
            *);;
    *);

    concept_sludge_chamber
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[иловая камера] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge chamber] (* <- lang_en;; *);;
    *);

// Показатели
concept_sludge_volume
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[объем осадка] (* <- lang_ru;; *);;
    => nrel_main_idtf:[sludge volume] (* <- lang_en;; *);;
    => nrel_has_unit:[м³] (* <- lang_ru;; *);;
*);

concept_sludge_moisture
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[влажность осадка] (* <- lang_ru;; *);;
    => nrel_main_idtf:[sludge moisture] (* <- lang_en;; *);;
    => nrel_has_unit:[%] (* <- lang_ru;; *);;
*);
concept_dark_gray_color
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_property;;
        => nrel_main_idtf:[темно-серая окраска] (* <- lang_ru;; *);;
        => nrel_main_idtf:[dark gray color] (* <- lang_en;; *);;
    *);

concept_granular_structure
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_property;;
        => nrel_main_idtf:[зернистая структура] (* <- lang_ru;; *);;
        => nrel_main_idtf:[granular structure] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Зернистая структура — морфологическая характеристика сброженного осадка, при которой он состоит из мелких, хорошо разделяемых частиц, что облегчает его обезвоживание.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_ph_value_digested_sludge
    (*
        <- concept_indicator;;
        <= nrel_inclusion: concept_indicator;;
        => nrel_main_idtf:[водородный показатель сброженного осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[pH value of digested sludge] (* <- lang_en;; *);;
        => nrel_has_unit: concept_ph_unit;;
        => nrel_min_value: 7.2;;
        => nrel_max_value: 7.6;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [pH сброженного осадка находится в диапазоне от 7,2 до 7,6, что соответствует щелочной среде и свидетельствует о завершении процесса сбраживания.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_hydrogen_sulfide_odor
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_odor;;
        => nrel_main_idtf:[запах сероводорода] (* <- lang_ru;; *);;
        => nrel_main_idtf:[hydrogen sulfide odor] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Запах сероводорода — характерный неприятный запах тухлых яиц, свидетельствующий о протекании анаэробных процессов гниения белков, образовании сероводорода в осадке или сточных водах, что указывает на нарушение режима эксплуатации очистных сооружений.]
                (* <- lang_ru;; *);;
            *);;
    *);
// Концепт "предупреждение выноса осадка"
concept_sludge_carryout_prevention
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[предупреждение выноса осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge carryout prevention] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Комплекс мер по предотвращению уноса осадка из отстойника вместе с осветленной водой.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "содержание в исправном состоянии"
concept_serviceability_maintenance
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_process;;
        => nrel_main_idtf:[содержание в исправном состоянии] (* <- lang_ru;; *);;
        => nrel_main_idtf:[serviceability maintenance] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс поддержания оборудования в работоспособном состоянии путем своевременного ремонта, замены деталей и технического обслуживания.]
                (* <- lang_ru;; *);;
            *);;
    *);
    // Концепт "механические скребки"
concept_mechanical_scrapers
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[механические скребки] (* <- lang_ru;; *);;
        => nrel_main_idtf:[mechanical scrapers] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Устройства, устанавливаемые в отстойниках (радиальных и горизонтальных) для механизированного сгребания осевшего на дно осадка к приямку. Наличие механических скребков определяет периодичность опорожнения отстойника для технического обслуживания: при наличии скребков — не реже 1 раза в 2 года, при отсутствии — не реже 1 раза в 3 года.]
                (* <- lang_ru;; *);;
            *);;
    *);
concept_sludge_layer_height
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_indicator;;
        => nrel_main_idtf:[высота слоя осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge layer height] (* <- lang_en;; *);;
        => nrel_has_unit:[м];;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Расстояние от дна иловой камеры до верхней границы накопившегося осадка. Контролируется для предотвращения переполнения и попадания осадка в отстойные желоба.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_fermented_sludge_residue
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[оставление сброженного осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[fermented sludge residue] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс оставления части объема сброженного осадка в иловой камере двухъярусного отстойника после выгрузки.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "обеспечение биомассы анаэробных микроорганизмов"
concept_anaerobic_biomass_provision
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[обеспечение биомассы анаэробных микроорганизмов] (* <- lang_ru;; *);;
        => nrel_main_idtf:[anaerobic biomass provision] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс поддержания необходимого количества анаэробных микроорганизмов в иловой камере для эффективного сбраживания поступающего сырого осадка.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "сбраживание сырого осадка"
concept_raw_sludge_fermentation
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_technological_process;;
        => nrel_main_idtf:[сбраживание сырого осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[raw sludge fermentation] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Процесс анаэробного разложения органических веществ в поступающем сыром осадке под действием микроорганизмов в двухъярусном отстойнике.]
                (* <- lang_ru;; *);;
            *);;
    *);
    concept_fermented_sludge_volume
    (*
        <- sc_node_class;;
        <= nrel_inclusion: concept_indicator;;
        => nrel_main_idtf:[объем сброженного осадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[fermented sludge volume] (* <- lang_en;; *);;
        => nrel_has_unit:[%];;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Часть объема сброженного осадка в иловой камере двухъярусного отстойника, которая оставляется после выгрузки для обеспечения биомассы анаэробных микроорганизмов.]
                (* <- lang_ru;; *);;
            *);;
    *);
concept_settling_duration
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[продолжительность отстаивания] (* <- lang_ru;; *);;
    => nrel_main_idtf:[settling duration] (* <- lang_en;; *);;
    => nrel_has_unit:[ч] (* <- lang_ru;; *);;
*);;
