subject_domain_of_sand_catchers

=> nrel_main_idtf:
    [Предметная область песколовок] (* <- lang_ru;; *);
<- subject_domain;
<- sc_node_structure;

-> rrel_maximum_studied_object_class:
    concept_sand_catcher
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[песколовка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand catcher] (* <- lang_en;; *);;
        => nrel_has_parameter: concept_sludge_volume;;
        => nrel_has_parameter: concept_sludge_density;;
        => nrel_has_parameter: concept_sludge_moisture;;
        => nrel_has_parameter: concept_sludge_ash_content;;
        => nrel_has_parameter: concept_sand_content;;
        => nrel_has_parameter: concept_sand_fractional_composition;;
        => rrel_has_part: concept_sand_pit_of_sand_catcher;;
        => rrel_has_part: concept_shutter;;
        <= nrel_inclusion: concept_mechanical_wastewater_treatment_facility;;
       <= nrel_sc_text_translation: ...
    (*
        <- concept_definition (*<- sc_node_class;;*);;
        -> [Песколовка — сооружение, в котором из сточных вод выделяется песок и другие мелкие минеральные примеси под действием силы тяжести или центробежной силы.] (* <- lang_ru;; *);;
    *);;
        <= nrel_subdividing:
        {
        concept_horizontal_sand_catcher;
        concept_vertical_sand_catcher; 
        concept_tangential_sand_catcher; 
        concept_aerated_sand_catcher
        };;
    *);

-> rrel_not_maximum_studied_object_class:

    concept_horizontal_sand_catcher
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[горизонтальная песколовка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[horizontal sand catcher] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Горизонтальная песколовка - <sc_element sys_idtf="concept_sand_catcher">песколовка</sc_element> с горизонтальным движением воды в которой песок оседает под действием силы тяжести.] 
                (* 
                <- lang_ru;; 
                => nrel_format: format_html;;
                  *);;
            *);;
    *);

    concept_vertical_sand_catcher
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[вертикальная песколовка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[vertical sand catcher] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Вертикальная песколовка - песколовка с вертикальным движением воды в которой песок оседает под действием силы тяжести.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_tangential_sand_catcher
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[тангенциальная песколовка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[tangential sand catcher] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Тангенциальная песколовка - песколовка в которой вода подается по касательной создавая вращательное движение что способствует выпадению песка под действием центробежных сил.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_aerated_sand_catcher
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[аэрируемая песколовка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[aerated sand catcher] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Аэрируемая песколовка - песколовка в которой подается воздух для поддержания органических примесей во взвешенном состоянии и улучшения отделения песка.] (* <- lang_ru;; *);;
                -> [Скорость воздуха в трубопроводах аэрируемых песколовок следует принимать не более 20 м/с для предотвращения чрезмерного шумового воздействия.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_sand
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[песок] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Песок - минеральные фракции взвешенных примесей задерживаемые в песколовках.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_shutter
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[затвор] (* <- lang_ru;; *);;
        => nrel_main_idtf:[shutter] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Затвор - устройство для перекрытия потока воды до и после песколовки.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_sand_pit_of_sand_catcher
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[песковый приямок] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand pit] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Песковый приямок - углубление в песколовке для сбора выпавшего песка.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_wall
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[стена] (* <- lang_ru;; *);;
        => nrel_main_idtf:[wall] (* <- lang_en;; *);;
    *);

    concept_facility_for_sand_processing
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[сооружение для обработки песка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand processing facility] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Сооружение для обработки песка - сооружение куда попадает песок после его извлечения из сточных вод на песколовках.] (* <- lang_ru;; *);;
            *);;
        <= nrel_subdividing: concept_facility_for_sand_processing_by_dehydration_flushing; concept_facility_for_sand_processing_by_dehydration;;
    *);

    concept_facility_for_sand_processing_by_dehydration_flushing
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[сооружение для отмывки и обезвоживания песка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand washing and dewatering facility] (* <- lang_en;; *);;
        <= nrel_subdividing: concept_sand_flusher; concept_sand_classificator;;
    *);

    concept_facility_for_sand_processing_by_dehydration
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[сооружение для обезвоживания песка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand dewatering facility] (* <- lang_en;; *);;
        <= nrel_subdividing: concept_sand_platform; concept_sand_storage_bunker;;
    *);

    concept_sand_flusher
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[пескопромыватель] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand washer] (* <- lang_en;; *);;
    *);

    concept_sand_classificator
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[классификатор песка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand classifier] (* <- lang_en;; *);;
    *);

// Концепт "песковая площадка"
concept_sand_platform
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[песковая площадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand platform] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Специально оборудованная открытая площадка на территории очистных сооружений для обезвоживания и временного хранения песка, извлечённого из песколовок.]
                (* <- lang_ru;; *);;
            *);;
    *);

// Концепт "доступность для погрузки на транспорт"
concept_loading_accessibility
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[доступность для погрузки на транспорт] (* <- lang_ru;; *);;
        => nrel_main_idtf:[loading accessibility] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Свойство места хранения (песковой площадки, контейнера, бункера), обеспечивающее свободный подъезд погрузочной техники (экскаватора, погрузчика) и возможность механизированной загрузки материала в транспортные средства для вывоза.]
                (* <- lang_ru;; *);;
            *);;
    *);

    concept_sand_storage_bunker
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[накопитель-бункер для песка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sand storage bunker] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Накопитель-бункер для песка - сооружение для хранения обезвоженного песка. В накопителях слой напуска песка не должен превышать 3 м.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_drainage_water
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[дренажная вода] (* <- lang_ru;; *);;
        => nrel_main_idtf:[drainage water] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Дренажную воду из сооружений для отмывки и обезвоживания песка следует возвращать в поток очищаемых сточных вод перед песколовками.] (* <- lang_ru;; *);;
            *);;
    *);

// Показатели для песколовок
concept_sand_content
(*
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[содержание песка] (* <- lang_ru;; *);;
    => nrel_main_idtf:[sand content] (* <- lang_en;; *);;
    => nrel_has_unit:[%] (* <- lang_ru;; *);;
*);
concept_sand_catcher_efficiency
(*
    <- sc_node_class;;
    => nrel_main_idtf: [эффективность работы песколовки] (* <- lang_ru;; *);;
*);
concept_sand_retention
(*
    <- sc_node_class;;
    => nrel_main_idtf: [задержание песка] (* <- lang_ru;; *);;
*);
concept_mineral_fraction
(*
    <- sc_node_class;;
    => nrel_main_idtf: [содержание минеральных фракций] (* <- lang_ru;; *);;
*);
concept_ash_content_of_sand
(*
    <- sc_node_class;;
    => nrel_main_idtf: [зольность песка] (* <- lang_ru;; *);;
*);
concept_efficient_operation
(*
    <- sc_node_class;;
    => nrel_main_idtf: [эффективная работа] (* <- lang_ru;; *);;
*);
concept_sand_in_primary_sludge
(*
    <- sc_node_class;;
    => nrel_main_idtf: [содержание песка в осадке первичных отстойников] (* <- lang_ru;; *);;
   *); 
   
concept_sand_grain (*
    <- sc_node_class;;
    => nrel_main_idtf: [зерно песка] (* <- lang_ru;; *);;
    => nrel_main_idtf: [sand grain] (* <- lang_en;; *);;
    <= nrel_sc_text_translation: ...
        (*
            <- concept_definition (*<- sc_node_class;;*);;
            -> [Отдельная частица песка, образующаяся в результате разрушения горных пород]
            (* <- lang_ru;; *);;
        *);;
      *);
        
concept_sand_fractional_composition
(*  
    <- sc_node_class;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[фракционный состав песка] (* <- lang_ru;; *);;
    => nrel_main_idtf:[sand fractional composition] (* <- lang_en;; *);;
    => nrel_has_unit:[мм] (* <- lang_ru;; *);;
*);;
