subject_domain_of_hydrocyclones

=> nrel_main_idtf:
    [Предметная область гидроциклонов] (* <- lang_ru;; *);
<- subject_domain;
<- sc_node_structure;

-> rrel_maximum_studied_object_class:
    concept_hydrocyclone
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[гидроциклон] (* <- lang_ru;; *);;
        => nrel_main_idtf:[hydrocyclone] (* <- lang_en;; *);;
        <= nrel_inclusion: concept_mechanical_wastewater_treatment_facility;;
        => rrel_has_parameter: concept_hydraulic_load;;
        => rrel_has_parameter: concept_sludge_volume;;
        => rrel_has_parameter: concept_sludge_moisture;;
        => rrel_has_parameter: concept_suspended_solids_in_effluent;;
        => rrel_has_part: concept_sludge_nozzle;;
        => rrel_has_part: concept_drain_nozzle;;
        => rrel_has_part: concept_feed_liner;;
        => rrel_has_part: concept_supply_pipeline;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Гидроциклоны предназначены для осветления сточных вод при использовании процесса разделения суспензий и эмульсий в поле центробежных сил.] (* <- lang_ru;; *);;
                -> [Обеспечивать равномерное распределение расхода поступающих сточных вод между гидроциклонами не допуская чрезмерной нагрузки на отдельные аппараты.] (* <- lang_ru;; *);;
                -> [Поддерживать постоянными расход подаваемых на очистку сточных вод и давление перед гидроциклоном путем регулирования подачи питательного насоса или поддержания постоянной отметки уровня сточной воды в питательной емкости при самотечной подаче.] (* <- lang_ru;; *);;
                -> [Производить осмотр и очистку подводящих трубопроводов сливных и шламовых насадок и конструктивных элементов подверженных засорению.] (* <- lang_ru;; *);;
                -> [Своевременно заменять изнашивающиеся детали гидроциклонов в том числе шламовые насадки и вкладыши в питающих отверстиях.] (* <- lang_ru;; *);;
                -> [Перед пуском гидроциклона в эксплуатацию промывают подводящие трубопроводы для предотвращения его засорения.] (* <- lang_ru;; *);;
                -> [При пуске гидроциклона проверяют соответствие потерь напора по показаниям манометров с данными указанными в технической документации изготовителя.] (* <- lang_ru;; *);;
                -> [Регулировка режима работы гидроциклона осуществляется путем подбора соответствующих размеров сливных и шламовых насадок а также вкладышей питающего отверстия для достижения максимальной концентрации твердых примесей в осадке при их допустимом выносе с очищенной водой.] (* <- lang_ru;; *);;
                -> [Замена насадок при их подборе а также замена изношенных деталей гидроциклона осуществляются в соответствии с рекомендациями производителей гидроциклонов.] (* <- lang_ru;; *);;
            *);;
    *);

-> rrel_not_maximum_studied_object_class:

  
    concept_sludge_nozzle
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[шламовая насадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge nozzle] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Шламовая насадка - сменный элемент гидроциклона через который удаляется осадок.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_drain_nozzle
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[сливная насадка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[drain nozzle] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Сливная насадка - сменный элемент гидроциклона через который отводится очищенная вода.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_feed_liner
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[вкладыш питающего отверстия] (* <- lang_ru;; *);;
        => nrel_main_idtf:[feed liner] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Вкладыш питающего отверстия - сменный элемент гидроциклона в зоне подачи исходной воды.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_manometer
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[манометр] (* <- lang_ru;; *);;
        => nrel_main_idtf:[manometer] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Манометр - прибор для измерения давления перед гидроциклоном.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_feed_pump
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[питательный насос] (* <- lang_ru;; *);;
        => nrel_main_idtf:[feed pump] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Питательный насос - насос для подачи сточных вод в гидроциклон.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_feed_tank
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[питательная емкость] (* <- lang_ru;; *);;
        => nrel_main_idtf:[feed tank] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Питательная емкость - резервуар из которого сточная вода подается в гидроциклон самотеком.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_pressure_loss
    (*
        <- concept_indicator;;
        <= nrel_inclusion: concept_indicator;;
        => nrel_main_idtf:[потери напора] (* <- lang_ru;; *);;
        => nrel_main_idtf:[pressure loss] (* <- lang_en;; *);;
        => rrel_has_unit:[м] (* <- lang_ru;; *);;
    *);

// Показатели
concept_hydraulic_load
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[гидравлическая нагрузка] (* <- lang_ru;; *);;
    => nrel_main_idtf:[hydraulic load] (* <- lang_en;; *);;
    => rrel_has_unit:[м³/(м²·ч)] (* <- lang_ru;; *);;
*);;
