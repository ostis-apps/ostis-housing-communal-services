subject_domain_of_sifters

=> nrel_main_idtf:
    [Предметная область решеток и сит](* <- lang_ru;; *);
<- subject_domain;
<- sc_node_structure;

-> rrel_maximum_studied_object_class:
    concept_sifters
    (*
        <- sc_node_class;;
        => rrel_has_parameter: concept_debris_volume;;
        => rrel_has_parameter: concept_debris_moisture;;
        => rrel_has_parameter: concept_debris_ash_content;;
        => rrel_has_parameter: concept_debris_density;;
        => nrel_main_idtf:[решетки и сита] (* <- lang_ru;; *);;
        <= nrel_inclusion: concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Решетки и сита предназначены для задержания грубодисперсных примесей содержащихся в сточных водах.] (* <- lang_ru;; *);;
                -> [Поддерживать нагрузку на оборудование не превышающую их проектную пропускную способность путем выключения или включения в работу резервных агрегатов.] (* <- lang_ru;; *);;
                -> [Производить осмотр решеток и сит не допускать их чрезмерного засорения приводящего к снижению их пропускной способности и повышению уровня сточной воды в подводящем канале.] (* <- lang_ru;; *);;
                -> [Производить очистку решеток с ручной очисткой с периодичностью обеспечивающей их эксплуатацию в нормальном режиме но не реже 1 раза в 3 суток.] (* <- lang_ru;; *);;
                -> [Производить осмотр помещения решеток с оценкой функционирования систем вентиляции не реже 1 раза в сутки.] (* <- lang_ru;; *);;
                -> [Подводящий канал к решеткам и ситам а также камера для их размещения очищают от песка и крупноразмерных примесей по мере необходимости но не реже 1 раза в 6 месяцев.] (* <- lang_ru;; *);;
                -> [Измельчение отбросов задержанных на решетках и ситах с последующим их сбросом в поток сточной воды не рекомендуется за исключением случаев когда измельчение отбросов предусмотрено проектной документацией.] (* <- lang_ru;; *);;
                -> [Отбросы с решеток и сит собираются в закрытые контейнеры. Контейнеры оснащают отверстиями для отвода воды выделяющейся из отбросов в канализацию.] (* <- lang_ru;; *);;
                -> [В холодный период предусматриваются меры предотвращающие замерзание отбросов в контейнере. Содержимое контейнеров регулярно удаляется с периодичностью не реже чем через каждые 3 суток.] (* <- lang_ru;; *);;
                -> [В теплый период отбросы предназначенные для удаления при необходимости обрабатываются хлорсодержащими дезинфектантами.] (* <- lang_ru;; *);;
            *);;
        <= nrel_subdividing: 
        {
        concept_screen; 
        concept_sieve
        };;
    *);

-> rrel_not_maximum_studied_object_class:
    concept_screen
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[решетка] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Решетка - сооружение механической очистки предназначенное для задержания крупных грубодисперсных примесей из сточных вод.] (* <- lang_ru;; *);;
            *);;
        <= nrel_subdividing: concept_manual_cleaning_screen; concept_mechanical_cleaning_screen;;
    *);

    concept_manual_cleaning_screen
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[решетка с ручной очисткой] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Решетка с ручной очисткой - решетка очистка которой производится вручную с периодичностью не реже 1 раза в 3 суток.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_mechanical_cleaning_screen
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[решетка с механизированной очисткой] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Решетка с механизированной очисткой - решетка оснащенная механическим устройством для автоматического удаления задержанных отбросов.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_sieve
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[сито] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Сито - сооружение механической очистки предназначенное для задержания мелких грубодисперсных примесей из сточных вод.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_debris
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[отбросы] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Отбросы - задержанные на решетках и ситах грубодисперсные примеси удаляемые из сточных вод.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_supply_channel
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[подводящий канал] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Подводящий канал - гидротехническое сооружение для подачи сточных вод к решеткам и ситам.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_container
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[контейнер] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Контейнер - емкость для сбора и временного хранения отбросов удаляемых с решеток и сит.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_ventilation_system
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[система вентиляции] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Система вентиляции - комплекс оборудования для обеспечения воздухообмена в помещении решеток.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_disinfectant
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[дезинфектант] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Дезинфектант - химическое вещество используемое для обеззараживания отбросов в теплый период.] (* <- lang_ru;; *);;
            *);;
    *);

// Показатели для решеток и сит
concept_debris_volume
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[объем задерживаемых отбросов] (* <- lang_ru;; *);;
    => rrel_has_unit:[м³] (* <- lang_ru;; *);;
*);

concept_debris_moisture
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[влажность отбросов] (* <- lang_ru;; *);;
    => rrel_has_unit:[%] (* <- lang_ru;; *);;
*);

concept_debris_ash_content
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[зольность отбросов] (* <- lang_ru;; *);;
    => rrel_has_unit:[%] (* <- lang_ru;; *);;
*);

concept_debris_density
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[плотность отбросов] (* <- lang_ru;; *);;
    => rrel_has_unit:[кг/м³] (* <- lang_ru;; *);;
*);;
