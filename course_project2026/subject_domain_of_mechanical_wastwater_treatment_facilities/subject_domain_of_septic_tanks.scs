subject_domain_of_septic_tanks

=> nrel_main_idtf:
    [Предметная область септиков] (* <- lang_ru;; *);
<- subject_domain;
<- sc_node_structure;

-> rrel_maximum_studied_object_class:
    concept_septic_tank
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[септик] (* <- lang_ru;; *);;
        => nrel_main_idtf:[septic tank] (* <- lang_en;; *);;
        => rrel_has_parameter: concept_sludge_level;;
        => rrel_has_parameter: concept_suspended_solids_in_effluent;;
        => rrel_has_part: concept_tee;;
        => rrel_has_part: concept_inlet_pipeline;;
        => rrel_has_part: concept_outlet_pipeline;;
        <= nrel_inclusion: concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Септики предназначены для осветления сточных вод с одновременным хранением и сбраживанием осадка.] (* <- lang_ru;; *);;
                -> [При эксплуатации септиков в нормальном режиме содержание взвешенных веществ в осветленной воде не превышает 100 мг/дм3.] (* <- lang_ru;; *);;
                -> [Проводить наблюдения за уровнем осадка и своевременной его выгрузкой.] (* <- lang_ru;; *);;
                -> [Производить осмотр и при необходимости очистку подводящих и отводящих трубопроводов тройников от осадка.] (* <- lang_ru;; *);;
                -> [Уровень осадка определяют с помощью штанги или рейки его значение составляет ниже нижнего среза патрубка тройника на отводящем трубопроводе не менее чем на 0,1 м.] (* <- lang_ru;; *);;
                -> [Выгрузка осадка производится по мере его накопления но не реже 1 раза в год оставляя в септике часть объема сброженного осадка.] (* <- lang_ru;; *);;
                -> [Перед удалением осадка септик выводится из работы путем прекращения поступления в него сточной воды а также удаляется корка и пена образовавшиеся на поверхности сточной воды при их наличии. Удаление осадка производится с использованием насосов или специализированной техники по удалению и транспортированию сточных вод и канализационного осадка.] (* <- lang_ru;; *);;
            *);;
    *);

-> rrel_not_maximum_studied_object_class:

    concept_tee
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[тройник] (* <- lang_ru;; *);;
        => nrel_main_idtf:[tee] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Тройник - фитинг на трубопроводе септика для отвода осветленной воды.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_measuring_rod
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[штанга] (* <- lang_ru;; *);;
        => nrel_main_idtf:[measuring rod] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Штанга - приспособление для измерения уровня осадка в септике.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_measuring_rail
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[рейка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[measuring rail] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Рейка - приспособление для измерения уровня осадка в септике.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_foam
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[пена] (* <- lang_ru;; *);;
        => nrel_main_idtf:[foam] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Пена - образование на поверхности сточной воды в септике.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_scum
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[корка] (* <- lang_ru;; *);;
        => nrel_main_idtf:[scum] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Корка - твердое образование на поверхности сточной воды в септике.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_sludge
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[осадок] (* <- lang_ru;; *);;
        => nrel_main_idtf:[sludge] (* <- lang_en;; *);;
    *);

    concept_digested_sludge
    (*
        <- concept_sludge;;
        => nrel_main_idtf:[сброженный осадок] (* <- lang_ru;; *);;
        => nrel_main_idtf:[digested sludge] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Сброженный осадок - осадок прошедший процесс анаэробного сбраживания в септике.] (* <- lang_ru;; *);;
            *);;
    *);

    concept_specialized_equipment
    (*
        <- sc_node_class;;
        => nrel_main_idtf:[специализированная техника] (* <- lang_ru;; *);;
        => nrel_main_idtf:[specialized equipment] (* <- lang_en;; *);;
        <= nrel_sc_text_translation: ...
            (*
                <- concept_definition (*<- sc_node_class;;*);;
                -> [Специализированная техника - техника для удаления и транспортирования сточных вод и канализационного осадка.] (* <- lang_ru;; *);;
            *);;
    *);

// Показатели
concept_sludge_level
(*
    <- concept_indicator;;
    <= nrel_inclusion: concept_indicator;;
    => nrel_main_idtf:[уровень осадка] (* <- lang_ru;; *);;
    => nrel_main_idtf:[sludge level] (* <- lang_en;; *);;
    => rrel_has_unit:[м] (* <- lang_ru;; *);;
*);;
