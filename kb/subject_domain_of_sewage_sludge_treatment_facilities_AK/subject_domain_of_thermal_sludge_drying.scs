subject_domain_of_thermal_sludge_drying
=> nrel_main_idtf:
    [Предметная область термической сушки] (* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;

-> rrel_maximum_studied_object_class:
	concept_thermal_sludge_dryer
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[установка термической сушки] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Термическая сушка обеспечивает глубокое обезвоживание и термическое обеззараживание осадка.] (*<-lang_ru;;*);;
                    ->[Влажность готового гранулята должна находиться в пределах 10–30 %.] (*<-lang_ru;;*);;
                    ->[Для предотвращения пылевых взрывов концентрация кислорода в сушильной камере должна поддерживаться ниже 8 % по объему.] (*<-lang_ru;;*);;
                    ->[Система газоочистки должна обеспечивать возврат тепла и конденсацию водяных паров.] (*<-lang_ru;;*);;
	        *);;
	*);

-> rrel_not_maximum_studied_object_class:
