subject_domain_of_sludge_utilization
=> nrel_main_idtf:
    [Предметная область утилизации] (* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;

-> rrel_maximum_studied_object_class:
	concept_sludge_utilization_process
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[процесс утилизации] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Использование осадков в качестве удобрений требует их предварительного обеззараживания и стабилизации.] (*<-lang_ru;;*);;
                    ->[Запрещается внесение осадков в почву на водосборных площадях питьевых водоисточников и в границах населенных пунктов.] (*<-lang_ru;;*);;
                    ->[Нормы внесения осадков должны учитывать вынос питательных элементов растениями и фоновое содержание металлов в почве.] (*<-lang_ru;;*);;
	        *);;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_land_reclamation (* => nrel_main_idtf:[рекультивация нарушенных земель] (* <- lang_ru;; *);; *);
	concept_greenery_planting (* => nrel_main_idtf:[озеленение территорий] (* <- lang_ru;; *);; *);
	concept_fertilizer_application_rate (* => nrel_main_idtf:[доза внесения удобрений] (* <- lang_ru;; *);; *);;
