		=> nrel_definition:
		    [Отношение потока иловой смеси, рециркулируемой из нитрификационной зоны в денитрификационную, к расходу поступающей сточной воды.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_is_subject_to_monitoring_at_points_K7_to_K23 (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[является точкой наблюдений К7 - К23*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[is subject to monitoring at points K7 to K23*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_activated_sludge_facility;
		            concept_trickling_filter;
		            concept_secondary_settling_tank
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_activated_sludge_facility;;
		=> nrel_second_domain:
		    concept_biological_wastewater_treatment_facility;;
		=> nrel_definition:
		    [Отнесение технологического элемента или параметра к перечню контрольных точек наблюдений в соответствии с графиком производственного экологического контроля.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_has_manufacturer_declared_parameters (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[имеет параметры, заявленные изготовителем*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[has manufacturer declared parameters*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_factory_made_biological_treatment_facility
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_factory_made_biological_treatment_facility;;
		=> nrel_second_domain:
		    concept_biological_wastewater_treatment_facility;;
		=> nrel_definition:
		    [Наличие у сооружения заводского изготовления паспортных значений производительности, допустимых нагрузок и эффективности очистки, установленных предприятием-изготовителем.]
		    (* <- lang_ru;; *);;
	*);;

