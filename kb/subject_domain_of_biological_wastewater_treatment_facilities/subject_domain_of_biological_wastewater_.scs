-> rrel_explored_relation:
	rrel_has_washout_prevention_measure (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[мера по предотвращению выноса*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[washout prevention measure*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_biological_treatment_facility;
		            concept_trickling_filter
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_biological_treatment_facility;;
		=> nrel_second_domain:
		    concept_measure;;
		=> nrel_definition:
		    [Мера, направленная на предотвращение выноса биопленки или фильтрующей загрузки из биофильтра с потоком сточной воды.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_has_biofilm_overgrowth_prevention_measure (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[мера по предотвращению чрезмерного обрастания*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[biofilm overgrowth prevention measure*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_trickling_filter;
		            concept_biological_treatment_facility
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_trickling_filter;;
		=> nrel_second_domain:
		    concept_biofilm;;
		=> nrel_definition:
		    [Мера, предотвращающая избыточное накопление биопленки, приводящее к закупорке загрузочного материала и снижению эффективности очистки.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_has_silting_prevention_measure (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[мера по предотвращению заиливания*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[silting prevention measure*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_secondary_settling_tank;
		            concept_biological_treatment_facility;
		            concept_filtration_facility
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_secondary_settling_tank;;
		=> nrel_second_domain:
		    concept_activated_sludge;;
		=> nrel_definition:
		    [Комплекс мероприятий, предотвращающих накопление осадка в отстойниках и фильтрах, обеспечивающий сохранение проектной производительности сооружений.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_has_freezing_prevention_measure (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[мера по предотвращению обмерзания*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[freezing prevention measure*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_trickling_filter;
		            concept_biological_pond;
		            concept_aerated_pond
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_trickling_filter;;
		=> nrel_second_domain:
		    concept_temperature;;
		=> nrel_definition:
		    [Меры теплоизоляции и поддержания технологического режима, обеспечивающие работоспособность сооружений в холодный период года.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_is_used_for_nitrification (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[используется для нитрификации*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[is used for nitrification*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_activated_sludge_facility;
		            concept_trickling_filter;
		            concept_sbr_reactor
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_activated_sludge_facility;;
		=> nrel_second_domain:
		    concept_nitrification;;
		=> nrel_definition:
		    [Характеристика сооружения, указывающая на его способность обеспечивать процесс окисления аммонийного азота до нитратов в аэробных условиях.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_is_used_for_denitrification (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[используется для денитрификации*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[is used for denitrification*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_activated_sludge_facility;
		            concept_oxidation_ditch;
		            concept_sbr_reactor
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_activated_sludge_facility;;
		=> nrel_second_domain:
		    concept_denitrification;;
		=> nrel_definition:
		    [Способность сооружения обеспечивать восстановление нитратов до молекулярного азота в аноксидных условиях.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_is_used_for_phosphorus_removal (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[используется для удаления фосфора*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[is used for phosphorus removal*](* <- lang_en;; *);;
		<- rrel_explored_relation:
