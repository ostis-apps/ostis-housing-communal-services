		            concept_sbr_reactor
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_activated_sludge_facility;;
		=> nrel_second_domain:
		    concept_phosphorus_content;;
		=> nrel_definition:
		    [Способность сооружения обеспечивать биологическое или физико-химическое удаление соединений фосфора из сточных вод.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_has_oxygen_input_limitation_in_denitrificator (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[ограничение поступления кислорода в денитрификатор*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[oxygen input limitation in denitrificator*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_activated_sludge_facility;
		            concept_anoxic_conditions
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_activated_sludge_facility;;
		=> nrel_second_domain:
		    concept_dissolved_oxygen_concentration;;
		=> nrel_definition:
		    [Условие поддержания низкой концентрации растворенного кислорода (аноксидных условий) для эффективной работы денитрификаторов.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_has_sludge_recirculation_rate (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[степень рециркуляции активного ила*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[activated sludge recirculation rate*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_activated_sludge_facility;
		            concept_secondary_settling_tank
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_activated_sludge_facility;;
		=> nrel_second_domain:
		    concept_activated_sludge;;
		=> nrel_definition:
		    [Отношение расхода возвратного активного ила из вторичного отстойника к расходу поступающей сточной воды.]
		    (* <- lang_ru;; *);;
	*);
	
	rrel_has_mixture_recirculation_rate (*
		<- sc_node_non_role_relation;;
		=> nrel_main_idtf:[степень рециркуляции иловой смеси*](* <- lang_ru;; *);;
		=> nrel_main_idtf:[mixed liquor recirculation rate*](* <- lang_en;; *);;
		<- rrel_explored_relation:
		    subject_domain_of_biological_wastewater_treatment_facility;;
		<= nrel_inclusion:
		    rrel_membership;;
		=> nrel_definitional_domain:
		    ...
		    (*
		        <= nrel_set_union: {
		            concept_activated_sludge_facility;
		            concept_nitrification;
		            concept_denitrification
		        };;
		    *);;
		=> nrel_first_domain:
		    concept_activated_sludge_facility;;
		=> nrel_second_domain:
