subject_domain_of_biological_wastewater_treatment_facility
=> nrel_main_idtf:
	[Предметная область сооружений биологической очистки сточных вод] (* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;

=> nrel_private_subject_domain:
	subject_domain_of_biological_filters (*
		=> nrel_main_idtf:[Предметная область биофильтров](* <- lang_ru;; *);;
	*);
	subject_domain_of_facilities_for_biological_treatment_in_activated_sludge_systems (*
		<- sc_node_class;;
		=> nrel_main_idtf:[Предметная область сооружений биологической очистки с активным илом](* <- lang_ru;; *);;
	*);
	subject_domain_of_secondary_settling_tanks (*
		<- sc_node_class;;
		=> nrel_main_idtf:[Предметная область вторичных отстойников](* <- lang_ru;; *);;
	*);
	subject_domain_of_facilities_for_treatment_in_natural_conditions (*
		<- sc_node_class;;
		=> nrel_main_idtf:[Предметная область сооружений очистки в естественных условиях](* <- lang_ru;; *);;
	*);
	subject_domain_of_biological_ponds (*
		<- sc_node_class;;
		=> nrel_main_idtf:[Предметная область биологических прудов](* <- lang_ru;; *);;
	*);
	subject_domain_of_factory_made_biological_treatment_facilities (*
		<- sc_node_class;;
		=> nrel_main_idtf:[Предметная область сооружений биологической очистки заводского изготовления](* <- lang_ru;; *);;
	*);

