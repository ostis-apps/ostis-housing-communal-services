subject_domain_of_soil_treatment_facilities

=> nrel_main_idtf:
    [Предметная область сооружений для очистки сточных вод в грунте](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_soil_treatment_facility
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[сооружение для очистки сточных вод в грунте] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_biological_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Сооружения для очистки сточных вод в грунте применяются после предварительного осветления сточных вод на сооружениях механической очистки.]
	                (*<-lang_ru;;*);;
                    ->[Следует обеспечивать равномерную подачу сточных вод на карты.]
	                (*<-lang_ru;;*);;
                    ->[Производить регулировку подачи сточных вод с помощью шиберов, устанавливаемых в распределительных колодцах оросительной сети.]
	                (*<-lang_ru;;*);;
                    ->[Производить регулярный осмотр распределительных колодцев на оросительной сети.]
	                (*<-lang_ru;;*);;
                    ->[Производить при необходимости очистку колодца, прочистку оросителей и их промывку раствором хлорсодержащих дезинфектантов с концентрацией активного хлора от 50 до 100 мг/дм3 и расходом от 3 до 6 дм3 на 1 м длины оросителя.]
	                (*<-lang_ru;;*);;
                    ->[Поддерживать в исправном состоянии колодцы, трубопроводы и лотки для подачи сточных вод в сооружения и отведения из них очищенных сточных вод.]
	                (*<-lang_ru;;*);;
                    ->[Поддерживать в исправном состоянии и производить техническое обслуживание насосных установок для подачи сточных вод на сооружения.]
	                (*<-lang_ru;;*);;
                    ->[При чрезмерном заиливании и кольматации загрузки ее объем промывают водой с содержанием взвешенных веществ, не превышающих 20 мг/дм3, или заменить закольматированный объем фильтрующей загрузки.]
	                (*<-lang_ru;;*);;
	        *);;
        <= nrel_subdividing:
                concept_filtration_fields;
                concept_underground_filtration_fields;
                concept_filtering_trenches;
                concept_sand_and_gravel_filters;
                concept_ventilated_underground_filtration_areas;
                concept_soil_plant_areas;
                concept_filtering_wells;
                concept_ground_filtration_areas;;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_filtration_fields
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[поля фильтрации] (* <- lang_ru;; *);;
	*);
	concept_underground_filtration_fields
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[поля подземной фильтрации] (* <- lang_ru;; *);;
	*);
	concept_filtering_trenches
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[фильтрующие траншеи] (* <- lang_ru;; *);;
	*);
	concept_sand_and_gravel_filters
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[песчано-гравийные фильтры] (* <- lang_ru;; *);;
	*);
	concept_ventilated_underground_filtration_areas
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[вентилируемые площадки подземной фильтрации] (* <- lang_ru;; *);;
	*);
	concept_soil_plant_areas
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[грунтово-растительные площадки] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[При эксплуатации грунтово-растительных площадок, дополнительно к требованиям по эксплуатации закрытых сооружений очистки сточных вод в естественных условиях, необходимо производить очистку площадки с удалением высохших и погибших растений.]
	                (*<-lang_ru;;*);;
                    ->[Для грунтово-растительных площадок с горизонтальным потоком нагрузка сточных вод по ХПКст не превышает 16 г/(м2·сут), гидравлическая нагрузка – 0,04 м3/(м2·сут).]
	                (*<-lang_ru;;*);;
                    ->[Для грунтово-растительных площадок с вертикальным потоком нагрузка по ХПКст не превышает 20 г/(м2·сут), гидравлическая нагрузка – 0,08 м3/(м2·сут).]
	                (*<-lang_ru;;*);;
                    ->[На грунтово-растительных площадках с горизонтальным потоком в сборном колодце проводятся наблюдения за уровнем воды дренажной сети и с обеспечением поддержания его на отметках, обеспечивающих нормальный режим фильтрования горизонтального потока на площадке.]
	                (*<-lang_ru;;*);;
	        *);;
	*);
	concept_filtering_wells
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[фильтрующие колодцы] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[При эксплуатации фильтрующих колодцев необходимо: обеспечивать предварительное осветление сточных вод; не допускать чрезмерной гидравлической нагрузки на сооружение, при которой появляется слой сточной воды над загрузкой; производить периодический осмотр и удаление крупноразмерных примесей с поверхности загрузки.]
	                (*<-lang_ru;;*);;
                    ->[В случае появления слоя сточной воды над загрузкой необходимо: откачать воду переносным насосом; промыть поверхность загрузки чистой водой с рыхлением верхнего слоя; обработать раствором хлорсодержащих дезинфектантов с концентрацией активного хлора от 75 до 100 мг/дм3 с расходом от 15 до 20 л на 1 м2 поверхности загрузки.]
	                (*<-lang_ru;;*);;
                    ->[Допускается удаление верхнего слоя загрузки с последующей отмывкой или заменой.]
	                (*<-lang_ru;;*);;
	        *);;
	*);
	concept_ground_filtration_areas
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[грунтовые фильтрационные площадки] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[При эксплуатации грунтовых фильтрационных площадок необходимо: осуществлять равномерное распределение сточных вод по картам, не допускать подтопления и кольматации фильтрующего основания; своевременно производить скашивание травянистой растительности; производить промывку дренажной системы.]
	                (*<-lang_ru;;*);;
                    ->[При снижении фильтрационной способности основания вследствие кольматации фильтрующего основания, подачу сточных вод на карты приостанавливают для произведения сработки уровня до полного опорожнения карт.]
	                (*<-lang_ru;;*);;
                    ->[После удаления воды, карты грунтовых фильтрационных площадок необходимо просушить в течение не менее 2 недель и после произвести декольматацию верхнего слоя фильтрующего основания рыхлением.]
	                (*<-lang_ru;;*);;
                    ->[При необходимости при длительных периодах эксплуатации грунтовых фильтрационных площадок производят снятие и замену верхнего закольматированного слоя.]
	                (*<-lang_ru;;*);;
                    ->[Подача сточных вод в период проведения работ по декольматации осуществляется на резервные свободные карты.]
	                (*<-lang_ru;;*);;
                    ->[Перед холодным периодом и после его окончания необходимо проводить работы по очистке распределительной сети, осмотр запорной арматуры и их утепление.]
	                (*<-lang_ru;;*);;
	        *);;
	*);
	concept_irrigation_network
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[оросительная сеть] (* <- lang_ru;; *);;
	*);
	concept_distribution_manhole
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[распределительный колодец] (* <- lang_ru;; *);;
	*);
	concept_irrigator
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[ороситель] (* <- lang_ru;; *);;
	*);
	concept_loading_media_clogging
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[кольматация загрузки] (* <- lang_ru;; *);;
	*);
	concept_declogging
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[декольматация] (* <- lang_ru;; *);;
	*);
	concept_map
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[карта] (* <- lang_ru;; *);;
	*);
	concept_drainage_system
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[дренажная система] (* <- lang_ru;; *);;
	*);;
