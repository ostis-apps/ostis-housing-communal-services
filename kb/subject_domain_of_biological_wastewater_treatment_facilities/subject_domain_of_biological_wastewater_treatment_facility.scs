  *);
  
  concept_aerobic_treatment_facility
  (*
  <- sc_node_class;;
    => nrel_main_idtf:[сооружения аэробной очистки](* <- lang_ru;; *);;
    <= nrel_subdividing:
  concept_activated_sludge_tank;
  concept_biofilter;
  concept_rotating_biological_contactor;
  concept_submerged_biological_filter;
  concept_aerated_pond;
  concept_oxidation_ditch;;
   *);
   
  concept_attached_growth_reactor
  (*
  <- sc_node_class;;
    => nrel_main_idtf:[сооружения с прикрепленной биомассой](* <- lang_ru;; *);;
    <= nrel_subdividing:
  concept_biofilter;
  concept_rotating_biological_contactor;
  concept_submerged_biological_filter;;
   *);
   
  concept_suspended_growth_reactor
  (*
  <- sc_node_class;;
    => nrel_main_idtf:[сооружения со свободноплавающей биомассой](* <- lang_ru;; *);;
    <= nrel_subdividing:
  concept_activated_sludge_tank;
  concept_sbr_reactor;;
   *);
   
  -> rrel_explored_relation:
  
rrel_uses_aerobic_process
 (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf:[использует аэробный процесс*](* <- lang_ru;; *);;
    => nrel_first_domain: concept_aerobic_treatment_facility;;
    => nrel_second_domain: concept_aerobic_process;;
    => nrel_definition:
        [Аэротенки, биофильтры, оксидационные каналы, аэрируемые пруды используют аэробный процесс для окисления органических веществ при доступе кислорода.]
        (* <- lang_ru;; *);;
*);
rrel_uses_nitrification
 (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf:[использует нитрификацию*](* <- lang_ru;; *);;
    => nrel_first_domain: concept_activated_sludge_tank;;
    => nrel_second_domain: concept_nitrification;;
    => nrel_definition:
        [Сооружения биологической очистки активным илом используют процесс нитрификации для окисления аммонийного азота до нитратов.]
        (* <- lang_ru;; *);;
*);
rrel_uses_denitrification
 (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf:[использует денитрификацию*](* <- lang_ru;; *);;
    => nrel_first_domain: concept_activated_sludge_tank;;
    => nrel_second_domain: concept_denitrification;;
    => nrel_definition:
        [Сооружения биологической очистки активным илом с денитрификатором используют процесс денитрификации для восстановления нитратов до газообразного азота.]
        (* <- lang_ru;; *);;
*);
rrel_uses_biological_phosphorus_removal
 (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf:[использует биологическое удаление фосфора*](* <- lang_ru;; *);;
    => nrel_first_domain: concept_activated_sludge_tank;;
    => nrel_second_domain: concept_biological_phosphorus_removal;;
    => nrel_definition:
        [Сооружения биологической очистки активным илом с анаэробной зоной используют процесс биологического удаления фосфора.]
        (* <- lang_ru;; *);;
*);
rrel_uses_attached_growth
 (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf:[использует прикрепленную биомассу*](* <- lang_ru;; *);;
    => nrel_first_domain: concept_attached_growth_reactor;;
    => nrel_second_domain: concept_aerobic_process;;
    => nrel_definition:
        [Биофильтры, вращающиеся биологические контакторы и погружные биофильтры используют биоценоз прикрепленных форм микроорганизмов.]
        (* <- lang_ru;; *);;
*);
rrel_uses_suspended_growth
 (*
    <- sc_node_non_role_relation;;
    => nrel_main_idtf:[использует свободноплавающую биомассу*](* <- lang_ru;; *);;
    => nrel_first_domain: concept_suspended_growth_reactor;;
    => nrel_second_domain: concept_aerobic_process;;
    => nrel_definition:
        [Аэротенки и SBR-реакторы используют биоценоз свободноплавающих форм микроорганизмов (активный ил).]
        (* <- lang_ru;; *);;
*);;

