subject_domain_of_biological_wastewater_treatment_facility
=> nrel_main_idtf:
  [Предметная область сооружений биологической очистки сточных вод] (* <- lang_ru;; *);
  <- subject_domain;
  <- sc_node_structure;
  
  => nrel_private_subject_domain:
 subject_domain_of_biofilters;
  subject_domain_of_activated_sludge_facilities;
  subject_domain_of_secondary_settling_tanks;
  subject_domain_of_packaged_biological_treatment_units;
  subject_domain_of_filtration_beds;
  subject_domain_of_stabilization_ponds;
  subject_domain_of_soil_treatment_facilities;
  subject_domain_of_sbr_reactors;
  
-> rrel_maximum_studied_object_class:
  concept_biological_wastewater_treatment_facility(*
    <- sc_node_class;;
    => nrel_main_idtf:[сооружение биологической очистки сточных вод](* <- lang_ru;; *);;
  *);

-> rrel_not_maximum_studied_object_class:
  concept_biofilter;
  concept_rotating_biological_contactor;
  concept_submerged_biological_filter;
  concept_activated_sludge_tank;
  concept_secondary_settling_tank;
  concept_packaged_biological_treatment_unit;
  concept_filtration_bed;
  concept_stabilization_pond;
  concept_aerated_pond;
  concept_oxidation_ditch;
  concept_soil_treatment_facility;
  concept_sbr_reactor;

  
  concept_biological_process(*
    <- sc_node_class;;
    => nrel_main_idtf:[процесс биологической очистки сточных вод](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_biological_wastewater_treatment_facility;;
  *);
concept_aerobic_process(*
    <- sc_node_class;;
    => nrel_main_idtf:[аэробный процесс](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_biological_process;;
  *);
concept_anaerobic_process(*
    <- sc_node_class;;
    => nrel_main_idtf:[анаэробный процесс](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_biological_process;;
  *);
concept_anoxic_process(*
    <- sc_node_class;;
    => nrel_main_idtf:[аноксидный процесс](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_biological_process;;
  *);
concept_nitrification(*
    <- sc_node_class;;
    => nrel_main_idtf:[нитрификация](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_biological_process;;
  *);
concept_denitrification(*
    <- sc_node_class;;
    => nrel_main_idtf:[денитрификация](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_biological_process;;
  *);
concept_biological_phosphorus_removal(*
    <- sc_node_class;;
    => nrel_main_idtf:[биологическое удаление фосфора](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_biological_process;;
  *);

  concept_indicator_biological
  (*
    <- sc_node_class;;
    => nrel_main_idtf:[показатель технологического режима работы очистных сооружений биологической очистки](* <- lang_ru;; *);;
  *);

