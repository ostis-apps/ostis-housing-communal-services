subject_domain_of_oil_traps

=> nrel_main_idtf:
    [Предметная область нефтеловушек](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_oil_trap
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[нефтеловушка] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Нефтеловушки предназначены для осветления сточных вод и удаления из них нефтепродуктов.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать с помощью входных шиберов или задвижек равномерное распределение сточных вод между секциями нефтеловушек с расходами, не превышающими их пропускную способность.]
	                (*<-lang_ru;;*);;
                    ->[Осуществлять своевременное удаление задержанных нефтепродуктов и осадка по мере их накопления.]
	                (*<-lang_ru;;*);;
                    ->[Очищать подводящие и отводящие лотки от осадков и отложений.]
	                (*<-lang_ru;;*);;
                    ->[Постоянно следить за чистотой и исправностью распределительных и сборных лотков нефтесборных труб, водосливов и механизмов для сгребания и удаления осадка.]
	                (*<-lang_ru;;*);;
                    ->[Поддерживать горизонтальность водосливов и нефтесборных труб.]
	                (*<-lang_ru;;*);;
                    ->[Предотвращать засорение нефтесборных труб, производить их осмотр по мере необходимости, но не реже чем 1 раз в неделю.]
	                (*<-lang_ru;;*);;
                    ->[Нефтеловушки при эксплуатации закрываются перекрытиями, если иное не установлено проектной документацией.]
	                (*<-lang_ru;;*);;
                    ->[Сбор всплывших нефтепродуктов осуществляется не реже чем 1 раз в смену. Продолжительность сбора при включенном скребковом механизме не превышает 1 час.]
	                (*<-lang_ru;;*);;
                    ->[Нефтесборные трубы устанавливаются строго горизонтально, чтобы при их повороте вокруг продольной оси через прорезь, сделанную вдоль труб, поступали нефтепродукты с одного уровня во избежание попадания с ними большого количества воды.]
	                (*<-lang_ru;;*);;
                    ->[В нефтеловушках, не оборудованных нефтесборными трубами и скребками, сбор всплывших нефтепродуктов осуществляется по мере их накопления, как правило до достижения толщины слоя от 10 до 15 см, но не реже 1 раза в сутки.]
	                (*<-lang_ru;;*);;
                    ->[При наличии скребковых механизмов осадок, накопившийся в нефтеловушках, сгребают к приямку, из которого далее откачивать насосом, эжектором или выпускать через донные клапаны не реже чем 1 раз в сутки.]
	                (*<-lang_ru;;*);;
                    ->[При отсутствии скребковых механизмов очистку нефтеловушек необходимо проводить не реже 2 раз в год (весной и осенью).]
	                (*<-lang_ru;;*);;
	        *);;
        <= nrel_subdividing:
                concept_oil_trap_with_scraper;
                concept_oil_trap_without_scraper;;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_oil_trap_with_scraper
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[нефтеловушка со скребковым механизмом] (* <- lang_ru;; *);;
	*);
	concept_oil_trap_without_scraper
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[нефтеловушка без скребкового механизма] (* <- lang_ru;; *);;
	*);
	concept_oil_products
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[нефтепродукты] (* <- lang_ru;; *);;
	*);
	concept_oil_collection_pipe
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[нефтесборная труба] (* <- lang_ru;; *);;
	*);
	concept_oil_sump
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[приямок] (* <- lang_ru;; *);;
	
	*);;
