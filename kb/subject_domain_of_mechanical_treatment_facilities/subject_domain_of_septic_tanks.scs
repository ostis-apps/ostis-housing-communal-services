subject_domain_of_septic_tanks

=> nrel_main_idtf:
    [Предметная область септиков](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_septic_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[септик] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Септики предназначены для осветления сточных вод с одновременным хранением и сбраживанием осадка.]
	                (*<-lang_ru;;*);;
                    ->[При эксплуатации септиков в нормальном режиме содержание взвешенных веществ в осветленной воде не превышает 100 мг/дм3.]
	                (*<-lang_ru;;*);;
                    ->[Проводить наблюдения за уровнем осадка и своевременной его выгрузкой.]
	                (*<-lang_ru;;*);;
                    ->[Производить осмотр и при необходимости очистку подводящих и отводящих трубопроводов, тройников от осадка.]
	                (*<-lang_ru;;*);;
                    ->[Уровень осадка определяют с помощью штанги или рейки, его значение составляет ниже нижнего среза патрубка тройника на отводящем трубопроводе не менее, чем на 0,1 м.]
	                (*<-lang_ru;;*);;
                    ->[Выгрузка осадка производится по мере его накопления, но не реже 1 раза в год, оставляя в септике часть объема сброженного осадка.]
	                (*<-lang_ru;;*);;
                    ->[Перед удалением осадка септик выводится из работы путем прекращения поступления в него сточной воды, а также удаляется корка и пена, образовавшиеся на поверхности сточной воды при их наличии. Удаление осадка производится с использованием насосов или специализированной техники по удалению и транспортированию сточных вод и канализационного осадка.]
	                (*<-lang_ru;;*);;
	        *);;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_tee
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[тройник] (* <- lang_ru;; *);;
	*);
	concept_measuring_rod
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[штанга] (* <- lang_ru;; *);;
	*);
	concept_measuring_rail
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[рейка] (* <- lang_ru;; *);;
	*);
	concept_foam
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[пена] (* <- lang_ru;; *);;
	*);
	concept_scum
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[корка] (* <- lang_ru;; *);;
	
	*);;
