subject_domain_of_two_tier_settling_tanks

=> nrel_main_idtf:
    [Предметная область двухъярусных отстойников](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_two_tier_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[двухъярусный отстойник] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Двухъярусные отстойники предназначены для предварительного осветления сточных вод, поступающих на биологическую или физико-химическую очистку.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать равномерное распределение подаваемой сточной воды по секциям отстойников.]
	                (*<-lang_ru;;*);;
                    ->[Вести наблюдения за высотой слоя осадка в иловой камере и не допускать ее переполнения и поступления из нее осадка в отстойные желоба.]
	                (*<-lang_ru;;*);;
                    ->[Производить выпуск осадка по мере накопления, но не реже чем 1 раз в 3 месяца, с последующей промывкой илопроводов.]
	                (*<-lang_ru;;*);;
                    ->[Предотвращать образование на поверхности сточной воды в отстойнике плотной корки из взвешенных веществ и вспенивания сбраживаемого осадка.]
	                (*<-lang_ru;;*);;
                    ->[Очищать распределительные лотки и переливные кромки от задержавшихся на них осадка, отбросов и других примесей, удалять плавающие примеси, а также прочищать щели отстойных желобов.]
	                (*<-lang_ru;;*);;
                    ->[При наличии более одного отстойника на площадке для равномерного распределения осадка в иловых камерах периодически через каждые 10–15 суток необходимо переключать установленные в лотках шиберы для перепуска воды с одной линии сооружений на другую.]
	                (*<-lang_ru;;*);;
                    ->[При выгрузке осадка в иловой камере оставляется от 15 % до 20 % объема сброженного осадка для обеспечения достаточной биомассы анаэробных микроорганизмов для сбраживания поступающего сырого осадка.]
	                (*<-lang_ru;;*);;
                    ->[Перед наступлением холодного периода из отстойника выгружается осадок, отстойник утепляется путем перекрытия щитами. При этом лотки оставляются открытыми для возможности их очистки.]
	                (*<-lang_ru;;*);;
                    ->[Для проведения работ по техническому обслуживанию двухъярусный отстойник опорожняется не реже 1 раза в 4 года.]
	                (*<-lang_ru;;*);;
	        *);;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_sludge_level
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[уровень осадка] (* <- lang_ru;; *);;
	*);
	concept_sludge_volume
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[объем осадка] (* <- lang_ru;; *);;
	*);
	concept_sludge_moisture
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[влажность осадка] (* <- lang_ru;; *);;
	*);
	concept_sludge_ph
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[водородный показатель pH осадка] (* <- lang_ru;; *);;
	*);
	concept_scum
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[корка] (* <- lang_ru;; *);;
	*);;
