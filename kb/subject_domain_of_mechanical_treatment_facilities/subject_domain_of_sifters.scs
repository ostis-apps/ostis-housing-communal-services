subject_domain_of_sifters
//есть сомнения по уместности создания общего класса решеток и сит, в ЭкоНиПе сита и решетки это один подпункт и отдельно друг от друга они не описываются, так что делать две предметные области наверное не имеет смысла, поэтому есть мысль создать общий класс, который будет макс классов объектов исследования этой области и 1 доменом отношения 'использовать процесс процеживания'(название можно будет поменять  на 'просеиватель' или 'сооружения для процеживания')
=> nrel_main_idtf:
    [Предметная область решеток и сит](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_sifters
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[решетки и сита] (* <- lang_ru;; *);;
	    <= nrel_inclusion:
        concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Решетки и сита предназначены для задержания грубодисперсных примесей, содержащихся в сточных водах.]
	                (*<-lang_ru;;*);;
                    ->[Поддерживать нагрузку на оборудование не превышающую их проектную пропускную способность путем выключения или включения в работу резервных агрегатов.]
	                (*<-lang_ru;;*);;
                    ->[Производить осмотр решеток и сит, не допускать их чрезмерного засорения, приводящего к снижению их пропускной способности и повышению уровня сточной воды в подводящем канале.]
	                (*<-lang_ru;;*);;
                    ->[Производить очистку решеток с ручной очисткой с периодичностью, обеспечивающей их эксплуатацию в нормальном режиме, но не реже 1 раза в 3 суток.]
	                (*<-lang_ru;;*);;
                    ->[Производить осмотр помещения решеток с оценкой функционирования систем вентиляции не реже 1 раза в сутки.]
	                (*<-lang_ru;;*);;
                    ->[Подводящий канал к решеткам и ситам, а также камера для их размещения очищают от песка и крупноразмерных примесей по мере необходимости, но не реже 1 раза в 6 месяцев.]
	                (*<-lang_ru;;*);;
                    ->[Измельчение задержанных на решетках и ситах отбросов с последующим их сбросом в поток сточной воды не рекомендуется, за исключением случаев, когда измельчение отбросов предусмотрено проектной документацией.]
	                (*<-lang_ru;;*);;
                    ->[Отбросы с решеток и сит собираются в закрытые контейнеры. Контейнеры оснащают отверстиями для отвода воды, выделяющейся из отбросов, в канализацию.]
	                (*<-lang_ru;;*);;
                    ->[В холодный период предусматриваются меры, предотвращающие замерзание отбросов в контейнере. Содержимое контейнеров регулярно удаляется, с периодичностью не реже, чем через каждые 3 суток.]
	                (*<-lang_ru;;*);;
                    ->[В теплый период отбросы, предназначенные для удаления, при необходимости обрабатываются хлорсодержащими дезинфектантами.]
	                (*<-lang_ru;;*);;
	        *);;
	        
       <= nrel_subdividing:
			 concept_screen;
			 concept_sieve;;
	*);
              
-> rrel_not_maximum_studied_object_class:
              concept_screen(*
		<- sc_node_class;;
		=> nrel_main_idtf:[решетка] (* <- lang_ru;; *);;
		 <= nrel_subdividing:
		concept_manual_cleaning_screen;
		concept_mechanical_cleaning_screen;;
	*);
                concept_sieve(*
		<- sc_node_class;;
		=> nrel_main_idtf:[сито] (* <- lang_ru;; *);;
	*);
	concept_manual_cleaning_screen
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[решетка с ручной очисткой] (* <- lang_ru;; *);;
	*);
	concept_mechanical_cleaning_screen
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[решетка с механизированной очисткой] (* <- lang_ru;; *);;
	*);
	concept_sieve
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[сито] (* <- lang_ru;; *);;
	*);
	concept_debris
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[отбросы] (* <- lang_ru;; *);;
	*);
	concept_supply_channel
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[подводящий канал] (* <- lang_ru;; *);;
	*);
	concept_container
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[контейнер] (* <- lang_ru;; *);;
	*);
	concept_ventilation_system
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[система вентиляции] (* <- lang_ru;; *);;
	*);
	concept_disinfectant
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[дезинфектант] (* <- lang_ru;; *);;
	*);;
