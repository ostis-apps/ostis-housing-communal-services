subject_domain_of_mechanical_wastewater_treatment_facility
=> nrel_main_idtf:
  [Предметная область сооружений механической очистки сточных вод] (* <- lang_ru;; *);
  <- subject_domain;
  <- sc_node_structure;
  
  => nrel_private_subject_domain:
 subject_domain_of_sifters;
  subject_domain_of_sand_catchers;
  subject_domain_of_primary_settling_tanks;
  subject_domain_of_two_tier_settling_tanks;
  subject_domain_of_septic_tanks;
  subject_domain_of_oil_traps;
  subject_domain_of_grease_traps;
  subject_domain_of_filters;
  subject_domain_of_hydrocyclones;
  
-> rrel_maximum_studied_object_class:
  concept_mechanical_wastewater_treatment_facility(*
    <- sc_node_class;;
    => nrel_main_idtf:[сооружение механической очистки сточных вод](* <- lang_ru;; *);;
  *);

-> rrel_not_maximum_studied_object_class:
  concept_screen;
  concept_sieve;
  concept_sand_catcher;
  concept_primary_settling_tank;
  concept_two_tier_settling_tank;
  concept_septic_tank;
  concept_oil_trap;
  concept_grease_trap;
  concept_filter;
  concept_hydrocyclone;

  
  concept_process(*
    <- sc_node_class;;
    => nrel_main_idtf:[процесс механической очистки сточных вод](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_mechanical_wastewater_treatment_facility;;
  *);
concept_screening(*
    <- sc_node_class;;
    => nrel_main_idtf:[процеживание](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_process;;
  *);
concept_settling(*
    <- sc_node_class;;
    => nrel_main_idtf:[отстаивание](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_process;;
  *);
concept_filtration(*
    <- sc_node_class;;
    => nrel_main_idtf:[фильтрование](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_process;;
  *);
concept_centrifugal_separation(*
    <- sc_node_class;;
    => nrel_main_idtf:[обработка в поле центробежных сил](* <- lang_ru;; *);;
    <= nrel_inclusion:
        concept_process;;
  *);
  concept_indicator
  (*
    <- sc_node_class;;
    => nrel_main_idtf:[показатель технологического режима работы очистных сооружений механической очистки](* <- lang_ru;; *);;
  *);

