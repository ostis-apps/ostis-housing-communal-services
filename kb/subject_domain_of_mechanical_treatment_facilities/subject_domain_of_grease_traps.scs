subject_domain_of_grease_traps

=> nrel_main_idtf:
    [Предметная область жироловителей](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_grease_trap
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[жироловитель] (* <- lang_ru;; *);;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Жироловители предназначены для осветления сточных вод и удаления из них жиров.]
	                (*<-lang_ru;;*);;
                    ->[Осуществлять своевременное удаление задержанных жира и осадка по мере их накопления.]
	                (*<-lang_ru;;*);;
                    ->[Очищать подводящие и отводящие трубопроводы от осадков и жировых отложений.]
	                (*<-lang_ru;;*);;
                    ->[Рекомендуется производить удаление жира при толщине его слоя в рабочей камере жироуловителя более 0,2 м.]
	                (*<-lang_ru;;*);;
                    ->[Рекомендуется производить удаление осадка при его накоплении в жироуловителе более 30 % от объема рабочей камеры, но не реже чем 1 раз в год.]
	                (*<-lang_ru;;*);;
                    ->[После удаления задержанных жира и осадка из жироуловителей и перед повторным включением в работу, их рабочий объем заполняют водой, не содержащей жировых примесей.]
	                (*<-lang_ru;;*);;
	        *);;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_grease
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[жир] (* <- lang_ru;; *);;
	
	*);;
