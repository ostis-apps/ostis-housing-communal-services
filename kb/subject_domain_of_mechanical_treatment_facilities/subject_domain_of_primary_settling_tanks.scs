subject_domain_of_primary_settling_tanks

=> nrel_main_idtf:
    [Предметная область первичных отстойников](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_primary_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[первичный отстойник] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Первичные отстойники предназначены для предварительного осветления сточных вод, поступающих на биологическую или физико-химическую очистку.]
	                (*<-lang_ru;;*);;
                    ->[При эксплуатации в нормальном режиме в вертикальных отстойниках при времени пребывания сточной воды 1,5 ч достигается снижение содержания взвешенных веществ до 40 %, в радиальных и горизонтальных – до 50 %.]
	                (*<-lang_ru;;*);;
                    ->[При увеличении времени пребывания сточной воды в отстойнике до 2,0 ч содержание взвешенных веществ дополнительно снижается на 5 %, при времени пребывания сточной воды в отстойнике 2,5 ч содержание взвешенных веществ дополнительно снижается на 10 %.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать равномерное распределение сточной воды между отстойниками.]
	                (*<-lang_ru;;*);;
                    ->[Очищать лотки и каналы, подводящие воду к отстойникам, от отложений осадка и отбросов, удалять не реже чем 1 раз в неделю плавающие примеси из распределительных камер отстойников и обрабатывать вместе с отбросами, задержанными на решетках.]
	                (*<-lang_ru;;*);;
                    ->[Прочищать каналы и лотки с перепадами от жировых отложений не реже чем 1 раз в неделю.]
	                (*<-lang_ru;;*);;
                    ->[Удалять с кромок водосливов сборных лотков задерживающиеся на них загрязнения.]
	                (*<-lang_ru;;*);;
                    ->[Своевременно удалять с поверхности отстойников плавающие примеси.]
	                (*<-lang_ru;;*);;
                    ->[Контролировать эффект осветления сточной воды и предупреждать вынос осадка.]
	                (*<-lang_ru;;*);;
                    ->[Содержать в исправном состоянии и чистоте задвижки, илоскребы, илососы, шиберы и прочее оборудование, прилегающую территорию.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать удаление осадка не реже 2 раз в сутки из вертикальных и горизонтальных отстойников, не оборудованных скребковыми механизмами; не реже 1 раза в смену – из радиальных и горизонтальных отстойников, оборудованных скребковыми механизмами.]
	                (*<-lang_ru;;*);;
                    ->[Вести наблюдения за влажностью выгружаемого осадка, не допуская чрезмерного ее повышения.]
	                (*<-lang_ru;;*);;
                    ->[Для проведения работ по техническому обслуживанию первичные отстойники опорожняют не реже 1 раза в 2 года при наличии механических скребков и не реже 1 раза в 3 года при их отсутствии.]
	                (*<-lang_ru;;*);;
                    ->[Режим эксплуатации первичных отстойников при использовании процессов ацидофикации для повышения эффективности удаления биогенных элементов на последующей ступени биологической очистки определяется проектной документацией.]
	                (*<-lang_ru;;*);;
	        *);;
        <= nrel_subdividing:
                concept_vertical_settling_tank;
                concept_radial_settling_tank;
                concept_horizontal_settling_tank;;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_vertical_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[вертикальный отстойник] (* <- lang_ru;; *);;
	*);
	concept_radial_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[радиальный отстойник] (* <- lang_ru;; *);;
	*);
	concept_horizontal_settling_tank
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[горизонтальный отстойник] (* <- lang_ru;; *);;
	*);
	concept_raw_sludge
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[сырой осадок] (* <- lang_ru;; *);;
	*);
	concept_floating_impurities
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[плавающие примеси] (* <- lang_ru;; *);;
	*);
	concept_sludge_scraper
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[илоскреб] (* <- lang_ru;; *);;
	*);
	concept_sludge_pump
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[илосос] (* <- lang_ru;; *);;
	*);
	concept_gate_valve
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[задвижка] (* <- lang_ru;; *);;
	*);
	concept_shutter
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[шибер] (* <- lang_ru;; *);;
	*);
	concept_acidification
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[ацидофикация] (* <- lang_ru;; *);;
	*);;
