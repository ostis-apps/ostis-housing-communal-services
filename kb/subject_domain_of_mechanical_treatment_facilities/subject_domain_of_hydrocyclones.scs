subject_domain_of_hydrocyclones

=> nrel_main_idtf:
    [Предметная область гидроциклонов](* <- lang_ru;; *);
	<- subject_domain;
	<- sc_node_structure;
	
-> rrel_maximum_studied_object_class:
	concept_hydrocyclone
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[гидроциклон] (* <- lang_ru;; *);;
		<= nrel_inclusion:
        concept_mechanical_wastewater_treatment_facility;;
        <= nrel_sc_text_translation: ...
	        (*
	            <- concept_definition (*<- sc_node_class;;*);;
	                ->[Гидроциклоны предназначены для осветления сточных вод при использовании процесса разделения суспензий и эмульсий в поле центробежных сил.]
	                (*<-lang_ru;;*);;
                    ->[Обеспечивать равномерное распределение расхода поступающих сточных вод между гидроциклонами, не допуская чрезмерной нагрузки на отдельные аппараты.]
	                (*<-lang_ru;;*);;
                    ->[Поддерживать постоянными расход подаваемых на очистку сточных вод и давление перед гидроциклоном путем регулирования подачи питательного насоса или поддержания постоянной отметки уровня сточной воды в питательной емкости при самотечной подаче.]
	                (*<-lang_ru;;*);;
                    ->[Производить осмотр и очистку подводящих трубопроводов, сливных и шламовых насадок и конструктивных элементов, подверженных засорению.]
	                (*<-lang_ru;;*);;
                    ->[Своевременно заменять изнашивающиеся детали гидроциклонов, в том числе шламовые насадки и вкладыши в питающих отверстиях.]
	                (*<-lang_ru;;*);;
                    ->[Перед пуском гидроциклона в эксплуатацию промывают подводящие трубопроводы для предотвращения его засорения.]
	                (*<-lang_ru;;*);;
                    ->[При пуске гидроциклона проверяют соответствие потерь напора по показаниям манометров с данными, указанными в технической документации изготовителя.]
	                (*<-lang_ru;;*);;
                    ->[Регулировка режима работы гидроциклона осуществляется путем подбора соответствующих размеров сливных и шламовых насадок, а также вкладышей питающего отверстия для достижения максимальной концентрации твердых примесей в осадке при их допустимом выносе с очищенной водой.]
	                (*<-lang_ru;;*);;
                    ->[Замена насадок при их подборе, а также замена изношенных деталей гидроциклона осуществляются в соответствии с рекомендациями производителей гидроциклонов.]
	                (*<-lang_ru;;*);;
	        *);;
	*);

-> rrel_not_maximum_studied_object_class:
	concept_hydraulic_load
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[гидравлическая нагрузка] (* <- lang_ru;; *);;
	*);
	concept_nozzle
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[насадка] (* <- lang_ru;; *);;
	*);
	concept_liner
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[вкладыш] (* <- lang_ru;; *);;
	*);
	concept_manometer
	(*
		<- sc_node_class;;
		=> nrel_main_idtf:[манометр] (* <- lang_ru;; *);;

	*);;
