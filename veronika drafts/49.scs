nrel_treatment_facility
=> nrel_main_idtf:
   [очистное сооружение*]
<- sc_node_non_role_relation;
<- rrel_explored_relation:
   subject_domain_of_physicochemical_treatment_facilities;
=> nrel_first_domain:
   concept_technological_process;
=> nrel_second_domain:
   concept_treatment_facility;;