concept_ensuring_efficiency_of_preliminary_treatment
=> nrel_main_idtf:
   [обеспечение эффективности предварительной очистки]
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_physicochemical_treatment_facilities;;
<= nrel_inclusion:
   concept_technological_process;;

