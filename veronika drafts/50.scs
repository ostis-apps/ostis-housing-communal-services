rrel_replaceable
=> nrel_main_idtf:
   [заменяемое']
<- sc_node_role_relation;
<- rrel_explored_relation:
   subject_domain_of_physicochemical_treatment_facilities;
=> nrel_first_domain:
   concept_replacement;
=> nrel_second_domain:
   concept_reagent;;

