   coalescing_filter_separator;
   coalescence_on_polypropylene_media;
=> nrel_definition:
   [Коалесценция — это физико-химический процесс слияния мелких капель эмульгированных жидкостей (нефтепродуктов, масел, жиров) в более крупные капли в сточной воде при прохождении через коалесцирующую насадку или фильтр, что ускоряет их последующее гравитационное отделение.]
   (*
       <- lang_ru;;
   *);;

concept_sorption
=> nrel_main_idtf:
   [сорбция]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   activated_carbon_adsorption;
   zeolite_adsorption;
   biochar_sorption;
=> nrel_definition:
   [Сорбция — это физико-химический процесс поглощения растворённых загрязнителей из сточной воды твёрдым сорбентом (активированный уголь, цеолит, силикагель) за счёт адсорбции на поверхности или абсорбции в объёме, применяемый для глубокой очистки от органических соединений, тяжёлых металлов и других примесей.]
   (*
       <- lang_ru;;
   *);;

concept_extraction
=> nrel_main_idtf:
   [экстракция]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   liquid_liquid_extraction;
   extraction_of_phenols_from_wastewater;
   solvent_extraction_recovery;
=> nrel_definition:
   [Экстракция — это физико-химический процесс извлечения растворённых органических загрязнителей (фенолы, масла, органические кислоты) из сточной воды путём контакта с несмешивающимся с водой органическим растворителем, в котором загрязнитель растворяется лучше, чем в воде, с последующим отделением экстрагента и регенерацией ценных компонентов.]
   (*
       <- lang_ru;;
   *);;

concept_evaporation
=> nrel_main_idtf:
   [выпаривание]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   vacuum_evaporation;
   heat_pump_evaporator;
   multi_effect_evaporation;
=> nrel_definition:
   [Выпаривание — это физико-химический процесс концентрирования сточных вод путём перевода воды в парообразное состояние под воздействием тепла, в результате чего нелетучие загрязнители остаются в жидком остатке (кубовом остатке), а конденсат может быть возвращён в производство или сброшен.]
   (*
       <- lang_ru;;
   *);;

concept_ion_exchange
=> nrel_main_idtf:
   [ионный обмен]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   cation_exchange_for_hardness_removal;
   anion_exchange_for_nitrate_removal;
   mixed_bed_ion_exchange;
=> nrel_definition:
   [Ионный обмен — это физико-химический процесс извлечения ионов загрязнителей (тяжёлых металлов, солей жёсткости, нитратов, нитритов, цианидов) из сточной воды с помощью твёрдых ионообменных материалов (катионитов и анионитов), где ионы загрязнителей замещаются на безвредные ионы (натрий, водород, гидроксил).]
   (*
       <- lang_ru;;
   *);;

