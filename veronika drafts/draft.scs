   (*
       <- lang_ru;;
   *);;

concept_flotation
=> nrel_main_idtf:
   [флотация]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   dissolved_air_flotation;
   induced_air_flotation;
   electroflotation;
   foam_flotation;
=> nrel_definition:
   [Флотация — это физико-химический процесс разделения твёрдых частиц или жидких примесей в сточной воде, основанный на их прилипании к пузырькам газа (обычно воздуха) и всплывании на поверхность, где они удаляются в виде пенного продукта.]
   (*
       <- lang_ru;;
   *);;

concept_coalescence
=> nrel_main_idtf:
   [коалесценция]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
