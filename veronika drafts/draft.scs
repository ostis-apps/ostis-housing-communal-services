concept_wastewater
=> nrel_main_idtf:
   [сточные воды]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_liquid_waste;
=> nrel_inclusion:
   concept_domestic_wastewater;
   concept_industrial_wastewater;
   concept_surface_runoff;
-> rrel_example:
   sewage_from_residential_building;
   effluent_from_chemical_plant;
   stormwater_from_highway;
=> nrel_definition:
   [Сточные воды — это воды, загрязнённые в результате хозяйственной и производственной деятельности человека или атмосферными осадками, стекающими с территорий населённых пунктов и промышленных площадок, требующие отведения и очистки перед сбросом в водные объекты или повторного использования.]
   (*
      <- lang_ru;;
   *);;

concept_reagent
=> nrel_main_idtf:
   [реагент]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_chemical_substance;
-> rrel_example:
   aluminum_sulfate;
   ferric_chloride;
   polyacrylamide;
   activated_carbon;
=> nrel_definition:
   [Реагент — это химическое вещество, которое добавляют в воду (сточную, природную или технологическую) для осуществления процессов коагуляции, флокуляции, осаждения, нейтрализации, окисления, восстановления или других целевых превращений загрязнителей.]
   (*
       <- lang_ru;;
   *);;

concept_chemical_solution
