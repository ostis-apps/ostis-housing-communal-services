-> rrel_example:
   aqueous_solution;
   saline_solution;
   coagulant_solution;
   alkaline_solution;
=> nrel_definition:
   [Химический раствор — это однородная система переменного состава, состоящая из двух или более компонентов — растворителя и растворённых веществ, находящихся в молекулярно-дисперсном состоянии.]
   (*
       <- lang_ru;;
   *);;

concept_neutralization
=> nrel_main_idtf:
   [нейтрализация]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   acid_wastewater_neutralization_with_alkali;
   alkaline_wastewater_neutralization_with_acid;
   filtration_through_carbonate_materials;
=> nrel_definition:
   [Нейтрализация — это физико-химический процесс очистки сточных вод, при котором pH среды доводится до нейтрального значения (6.5–8.5) путём добавления кислоты в щелочные воды или щёлочи — в кислые, либо фильтрованием через нейтрализующие материалы.]
   (*
       <- lang_ru;;
   *);;

concept_coagulation
=> nrel_main_idtf:
   [коагуляция]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   aluminum_sulfate_coagulation;
   ferric_chloride_coagulation;
   polyaluminum_chloride_coagulation;
=> nrel_definition:
   [Коагуляция — это физико-химический процесс укрупнения коллоидных и мелкодисперсных частиц загрязнений в сточной воде под действием вводимых реагентов-коагулянтов, приводящий к образованию хлопьев, способных к осаждению или флотации.]
   (*
       <- lang_ru;;
   *);;

concept_flocculation
=> nrel_main_idtf:
   [флокуляция]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   polymer_flocculation;
   polyacrylamide_flocculation;
   natural_flocculant_usage;
=> nrel_definition:
   [Флокуляция — это физико-химический процесс агрегации мелких хлопьев, образовавшихся на стадии коагуляции, в более крупные и прочные флокулы под действием высокомолекулярных реагентов-флокулянтов, что ускоряет их осаждение или всплывание.]
   (*
       <- lang_ru;;
   *);;

concept_oxidation
=> nrel_main_idtf:
   [окисление]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
   subject_domain_of_physical_processes;
   subject_domain_of_chemical_processes; //CHECK
<= nrel_inclusion:
   concept_physical_process;
   concept_chemical_process;
-> rrel_example:
   ozonation;
   hydrogen_peroxide_oxidation;
   chlorine_oxidation;
   potassium_permanganate_oxidation;
=> nrel_definition:
   [Окисление — это физико-химический процесс разрушения органических и неорганических загрязнителей сточных вод за счёт передачи электронов от загрязнителя к сильному окислителю (озон, хлор, пероксид водорода, перманганат калия), приводящий к образованию менее токсичных или легко удаляемых соединений.]
   (*
       <- lang_ru;;
   *);;

concept_reduction
=> nrel_main_idtf:
   [восстановление]
   (*
      <- lang_ru;;
   *);
