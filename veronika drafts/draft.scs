concept_oop_class
=> nrel_main_idtf:
   [класс в ООП]
   (*
      <- lang_ru;;
   *);
=> nrel_main_idtf:
   [class in OOP]
   (*
      <- lang_en;;
   *);
<- rrel_explored_concept:
   subject_domain_of_object_modeling_intelligent_systems;
<= nrel_inclusion:
   concept_abstract_data_type;
=> nrel_inclusion:
   concept_abstract_class;
   concept_interface_class;
-> rrel_example:
   class_A; 
=> nrel_definition:
  [Класс в ООП — это абстрактный тип данных, шаблон, по которому создаются объекты, определяющий их структуру (свойства) и поведение (методы).]
   (*
       <- lang_ru;;
   *);;


concept_physical_and_chemical_treatment_facility
=> nrel_main_idtf:
   [очистное сооружение физико-химической очистки]
   (*
      <- lang_ru;;
   *);
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_treatment_facilities;
<= nrel_inclusion:
   concept_treatment_facility;
-> rrel_example:
   flotation_unit;
   coagulation_settling_tank;
   sorption_filter;
=> nrel_definition:
   [Очистное сооружение физико-химической очистки — это инженерный объект, в котором удаление загрязнений из воды (сточной, природной или технологической) осуществляется преимущественно физическими и химическими методами: коагуляцией, флотацией, сорбцией, экстракцией, ионным обменом, электрохимической обработкой и др.]
   (*
       <- lang_ru;;
   *);;

