nrel_disinfection_method
=> nrel_main_idtf:
   [метод дезинфекции*]
<- sc_node_non_role_relation;
<- rrel_explored_relation:
   subject_domain_of_disinfection_facilities;
=> nrel_first_domain:
   concept_wastewater_disinfection_facility;
=> nrel_second_domain:
   concept_disinfection_method;;

concept_disinfection_method
=> nrel_main_idtf:
   [метод дезинфекции]
<- sc_node_class;
<- rrel_explored_concept:
   subject_domain_of_disinfection_facilities;;

